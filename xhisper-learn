#!/usr/bin/env python3
"""xhisper-learn: teach xhisper your own words from the corrections you make.

Learned words go to ~/.config/xhisper/dictionary.txt, which xhisper passes to
Whisper as spelling hints and to the auto-edit model as vocabulary.

  xhisper-learn add WORD...     add words yourself
  xhisper-learn remove WORD...  forget words
  xhisper-learn list            print the dictionary
  xhisper-learn diff            stdin {"old": ..., "new": ...}: learn from an
                                edit (used by the History window); prints the
                                words it learned
  xhisper-learn watch           stdin: the text just pasted. Follows the focused
                                text field through AT-SPI (Linux) or the
                                Accessibility API (macOS, via Xhisper.app) for
                                a minute and learns the words you correct in it
  xhisper-learn context         print the text just before the cursor in the
                                focused field (screen-context for auto-edit)
  xhisper-learn before          the field at the cursor: "C" + the character
                                before it, "E" (empty field), "U" (unreadable)
  xhisper-learn spacing         stdin "STATE\0TERMINAL\0APP\0TEXT": prints
                                "space" when TEXT needs a leading space

A word is learned only when it *replaces* dictated words (typing more text is
not a correction) and is not an ordinary English word. Lowercase words must
also be a real change of word ("Qulify" -> "coolify"), not a spelling touch-up
("reporte" -> "reportée"), so typo and accent fixes teach nothing.
"""

import difflib
import json
import os
import re
import signal
import subprocess
import sys
import time
import unicodedata

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "xhisper")
DICTIONARY_FILE = os.path.join(CONFIG_DIR, "dictionary.txt")
CONFIG_FILE = os.path.join(CONFIG_DIR, "xhisperrc")
LEARNED_PILL_MS = 6000  # time to reach the Unlearn button (more while hovered)


def runtime_dir():
    """Same rule as xhisper.sh: XHISPER_RUNTIME_DIR, else XDG_RUNTIME_DIR/xhisper,
    else (macOS) the per-user temp dir + xhisper, else /tmp/xhisper."""
    if os.environ.get("XHISPER_RUNTIME_DIR"):
        return os.environ["XHISPER_RUNTIME_DIR"]
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base and sys.platform == "darwin":
        try:
            # _CS_DARWIN_USER_TEMP_DIR; python has no name for it.
            base = os.confstr(65537).rstrip("/")
        except (ValueError, OSError):
            base = None
    return os.path.join(base or "/tmp", "xhisper")


RUNTIME_DIR = runtime_dir()
WATCH_PID_FILE = os.path.join(RUNTIME_DIR, "xhisper-learn.pid")
XHISPER_PID_FILE = os.path.join(RUNTIME_DIR, "xhisper.pid")
WORD_LIST = "/usr/share/dict/words"

WATCH_SECONDS = 60
POLL_SECONDS = 0.5
SETTLE_SECONDS = 3.0      # a correction must sit unchanged this long (or be sent)
MAX_REPLACEMENT_WORDS = 4  # longer rewrites are edits, not corrections

WORD_RE = re.compile(r"\w(?:[\w'’.+#-]*\w)?")


def tokenize(text):
    return WORD_RE.findall(text)


def load_dictionary():
    words = []
    try:
        with open(DICTIONARY_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    words.append(line)
    except OSError:
        pass
    return words


_english = None


def english_words():
    global _english
    if _english is None:
        try:
            with open(WORD_LIST, encoding="utf-8", errors="replace") as f:
                _english = {w.strip().lower() for w in f}
        except OSError:
            _english = set()
    return _english


def english_stems(word):
    """Base forms of an inflected word. macOS's list (web2) holds only base
    forms: use, question, deploy - not using, questions, deployed."""
    w = word.lower().replace("\u2019", "'")
    for suffix in ("n't", "'s", "'re", "'ve", "'ll", "'d", "'m"):
        if w.endswith(suffix) and len(w) > len(suffix):
            base = w[:-len(suffix)]
            return [base, base + "n"] if suffix == "n't" else [base]  # can't -> can
    out = []

    def undouble(s):
        return [s[:-1]] if len(s) >= 3 and s[-1] == s[-2] and s[-1] not in "aeiou" else []

    if w.endswith("ies") and len(w) > 4:
        out.append(w[:-3] + "y")
    if w.endswith("es") and len(w) > 3:
        out.append(w[:-2])
    if w.endswith("s") and not w.endswith("ss") and len(w) > 3:
        out.append(w[:-1])
    for suffix in ("ing", "ed", "er", "est"):
        if w.endswith(suffix) and len(w) - len(suffix) >= 2:
            base = w[:-len(suffix)]
            out += [base, base + "e"] + undouble(base)
            if base.endswith("i"):
                out.append(base[:-1] + "y")  # studied, happier
    if w.endswith("ly") and len(w) > 4:
        base = w[:-2]
        out.append(base)
        if base.endswith("i"):
            out.append(base[:-1] + "y")
    return out


def is_english(word, platform=sys.platform, words=None):
    """An ordinary English word? Linux's list has inflected forms; on macOS
    their stems are looked up too."""
    words = english_words() if words is None else words
    low = word.lower()
    if low in words:
        return True
    return platform == "darwin" and any(s in words for s in english_stems(low))


LOWERCASE_MAX_SIMILARITY = 0.8


def plain(text):
    """Lowercase without accents: 'Réunion' -> 'reunion'."""
    decomposed = unicodedata.normalize("NFKD", text.lower())
    return "".join(c for c in decomposed if not unicodedata.combining(c))


def is_candidate(word, known, replaced=None):
    """Worth learning? `replaced` is the dictated text the word took over from.

    Names with a capital or a digit (TOSIAM, GraphQL, k8s) only need to be
    unusual. All-lowercase words (coolify, kubectl) must also differ enough
    from what they replaced: there is only an English word list here, so a
    French accent or one-letter fix would otherwise be learned."""
    if len(word) < 2 or word in known or is_english(word):
        return False
    if any(c.isupper() or c.isdigit() for c in word):
        return True
    if not replaced:
        return False
    a, b = plain(replaced).replace(" ", ""), plain(word)
    return a != b and difflib.SequenceMatcher(None, a, b).ratio() < LOWERCASE_MAX_SIMILARITY


def merged(word, replaced):
    """True for an editing slip that glued a dictated word onto the fix, like
    "using QLIFY" -> "usingcoolifyY" (the space got deleted)."""
    low = word.lower()
    if low == "".join(replaced).lower():
        return False  # "graph QL" -> "GraphQL": joining the split word is the fix
    return any(len(r) >= 3 and r.lower() != low and is_english(r)
               and (low.startswith(r.lower()) or low.endswith(r.lower()))
               for r in replaced)


def corrections(old_words, new_words):
    """Words in new_words that replace (not merely extend) old_words."""
    known = set(load_dictionary())
    found = []
    matcher = difflib.SequenceMatcher(None, [w.lower() for w in old_words],
                                      [w.lower() for w in new_words], autojunk=False)
    for op, i1, i2, j1, j2 in matcher.get_opcodes():
        if op == "equal":
            # Same word ignoring case: a casing fix (tosiam -> TOSIAM) counts.
            pairs = zip(old_words[i1:i2], new_words[j1:j2])
            found += [new for old, new in pairs if old != new and is_candidate(new, known)]
        elif op == "replace" and j2 - j1 <= MAX_REPLACEMENT_WORDS:
            replaced = old_words[i1:i2]
            found += [w for w in new_words[j1:j2]
                      if w not in replaced and not merged(w, replaced)
                      and is_candidate(w, known, " ".join(replaced))]
    return list(dict.fromkeys(found))


def add_words(words):
    """Append the words not yet in the dictionary; return the ones added."""
    known = set(load_dictionary())
    new = [w for w in dict.fromkeys(words) if w and w not in known]
    if not new:
        return []
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fresh = not os.path.exists(DICTIONARY_FILE)
    with open(DICTIONARY_FILE, "a", encoding="utf-8") as f:
        if fresh:
            f.write("# xhisper personal dictionary: one word or phrase per line.\n")
        for w in new:
            f.write(w + "\n")
    return new


def remove_words(words):
    gone = set(words)
    try:
        with open(DICTIONARY_FILE, encoding="utf-8") as f:
            lines = f.readlines()
    except OSError:
        return []
    kept = [l for l in lines if l.strip() not in gone]
    with open(DICTIONARY_FILE + ".tmp", "w", encoding="utf-8") as f:
        f.writelines(kept)
    os.replace(DICTIONARY_FILE + ".tmp", DICTIONARY_FILE)
    return [w for w in words if any(l.strip() == w for l in lines)]


def sibling(name):
    path = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), name)
    return path if os.access(path, os.X_OK) else name


def app_binary():
    """Xhisper.app's binary on macOS (exported by xhisper.sh, --local aware)."""
    return os.environ.get("XHISPER_APP") or "/Applications/Xhisper.app/Contents/MacOS/Xhisper"


DEFAULT_LEARNED_SOUND = "/System/Library/Sounds/Glass.aiff" if sys.platform == "darwin" else ""


def dictation_running():
    try:
        with open(XHISPER_PID_FILE) as f:
            os.kill(int(f.read().split()[0]), 0)
        return True
    except (OSError, ValueError, IndexError):
        return False


def config_value(key, default=""):
    """One `key : value` from xhisperrc, parsed like xhisper.sh does (trims
    whitespace and surrounding quotes, drops a trailing ' # comment')."""
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            for line in f:
                name, sep, value = line.partition(":")
                if not sep or name.strip() != key:
                    continue
                value = value.strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                    return value[1:-1]
                return value.split(" #", 1)[0].strip()
    except OSError:
        pass
    return default


def play(sound):
    if not sound or not os.path.isfile(sound):
        return
    for player in (("afplay",) if sys.platform == "darwin" else ("paplay", "pw-play")):
        try:
            subprocess.Popen([player, sound], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return
        except OSError:
            continue


def announce(words):
    """Achievement sound and a "Learned: WORD" pill with an Unlearn button."""
    # Never take over the pill while a dictation is showing its own state.
    if not words or dictation_running():
        return
    play(config_value("learned-sound", DEFAULT_LEARNED_SOUND))
    if sys.platform == "darwin":
        # The pill is Xhisper.app; tell it where we are for its Unlearn button.
        notify, env = [app_binary(), "notify"], dict(os.environ, XHISPER_LEARN=os.path.realpath(sys.argv[0]))
    else:
        notify, env = [sibling("xhisper-notify")], None
    try:
        subprocess.Popen(notify + ["learned", "--label", "Learned: " + ", ".join(words),
                                   "--unlearn", ",".join(words), "--timeout", str(LEARNED_PILL_MS)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, env=env)
    except OSError:
        pass


# ----- AT-SPI watcher -----------------------------------------------------

def active_window_pid():
    """PID of the focused X11 window, or None (Wayland, no xdotool)."""
    if os.environ.get("XDG_SESSION_TYPE") == "wayland":
        return None
    try:
        out = subprocess.run(["xdotool", "getactivewindow", "getwindowpid"],
                             capture_output=True, timeout=2).stdout.decode().strip()
        return int(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def focused_text_node(Atspi):
    """The focused accessible with a Text interface in the active window.

    AT-SPI's ACTIVE state is unreliable on its own (a backgrounded Chrome and
    mutter's frame windows both keep claiming it), so on X11 the app is picked
    by the PID of the window the X server says is focused. Without that, a
    focused field that has a caret is preferred."""
    pid = active_window_pid()
    desktop = Atspi.get_desktop(0)
    fallback = None
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if app is None:
            continue
        try:
            if pid is not None and app.get_process_id() != pid:
                continue
        except Exception:
            continue
        for j in range(app.get_child_count()):
            win = app.get_child_at_index(j)
            try:
                if not win.get_state_set().contains(Atspi.StateType.ACTIVE):
                    continue
            except Exception:
                continue
            stack, seen = [win], 0
            while stack and seen < 20000:
                node = stack.pop()
                seen += 1
                try:
                    if node.get_state_set().contains(Atspi.StateType.FOCUSED):
                        if node.get_text_iface() is None:
                            break
                        if pid is not None or Atspi.Text.get_caret_offset(node) >= 0:
                            return node
                        fallback = fallback or node
                        break
                    stack.extend(node.get_child_at_index(k) for k in range(node.get_child_count()))
                except Exception:
                    continue
    return fallback


class AtspiReader:
    """The focused text field through AT-SPI (Linux). The calls watch() and
    context() used to make inline, moved here unchanged."""

    def __init__(self):
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi
        self.Atspi, self.node = Atspi, None

    def attach(self):
        self.node = focused_text_node(self.Atspi)
        return self.node is not None

    def role(self):
        return self.node.get_role_name()

    def read(self):
        """(text, caret), or None once the field went away."""
        try:
            return (self.Atspi.Text.get_text(self.node, 0, -1),
                    self.Atspi.Text.get_caret_offset(self.node))
        except Exception:
            return None

    def before_caret(self, limit):
        try:
            caret = self.Atspi.Text.get_caret_offset(self.node)
            count = self.Atspi.Text.get_character_count(self.node)
            end = caret if 0 <= caret <= count else count
            return self.Atspi.Text.get_text(self.node, max(0, end - limit), end)
        except Exception:
            return ""

    def is_empty(self):
        try:
            return self.Atspi.Text.get_character_count(self.node) == 0
        except Exception:
            return False

    def close(self):
        pass


class AxReader:
    """The focused text field through the macOS Accessibility API, read by
    `Xhisper ax --follow`: it pins the element and answers one JSON line per
    request. The text comes over the pipe, never argv."""

    def __init__(self):
        if not os.access(app_binary(), os.X_OK):
            raise ImportError("Xhisper.app not found")
        self.proc, self.first = None, {}

    def attach(self):
        try:
            self.proc = subprocess.Popen([app_binary(), "ax", "--follow"], stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            return False
        self.first = self._ask() or {}
        return "text" in self.first

    def _ask(self):
        try:
            self.proc.stdin.write(b"\n")
            self.proc.stdin.flush()
            line = self.proc.stdout.readline()
            return json.loads(line.decode("utf-8")) if line else None
        except (OSError, ValueError):
            return None

    @property
    def denied(self):
        """Xhisper.app itself lacks the Accessibility permission."""
        return bool(self.first.get("denied"))

    def role(self):
        return self.first.get("role") or "text field"

    def read(self):
        snap = self._ask()
        if not snap or snap.get("gone") or "text" not in snap:
            return None
        return snap["text"], snap.get("caret", -1)

    def before_caret(self, limit):
        text, caret = self.first.get("text", ""), self.first.get("caret", -1)
        end = caret if 0 <= caret <= len(text) else len(text)
        return text[max(0, end - limit):end]

    def is_empty(self):
        return self.first.get("text", "") == ""

    def close(self):
        if self.proc:
            try:
                self.proc.kill()
                self.proc.wait(timeout=1)
            except (OSError, subprocess.SubprocessError):
                pass


READER_UNAVAILABLE = ("Xhisper.app not found, not watching" if sys.platform == "darwin"
                      else "AT-SPI (gir1.2-atspi-2.0) unavailable, not watching")


def open_reader():
    """This platform's reader. Raises ImportError/ValueError when the
    accessibility layer is unavailable."""
    return AxReader() if sys.platform == "darwin" else AtspiReader()


def locate(target, text, caret=-1):
    """The words of the dictated text as they now stand in `text`, or None.

    Fuzzy, so line wrapping, terminal redraws and the user's own edits do not
    lose track of it. Only the text around the caret is searched - the user
    edits where the caret is - and the copy containing the caret wins over an
    older verbatim copy elsewhere on the page."""
    size = len(target)
    reach = 3 * sum(len(w) + 1 for w in target) + 200
    if caret is None or caret < 0:
        caret = len(text)
    lo = max(0, caret - reach)
    part = text[lo:caret + reach]
    caret -= lo
    found = list(WORD_RE.finditer(part))
    words = [f.group() for f in found]
    tl = [w.lower() for w in target]
    tset = set(tl)
    lw = [w.lower() for w in words]
    # Just longer than the dictation: a wider window would reach into a
    # neighbouring copy and lock onto it.
    span = size + max(2, size // 5)
    best_key, best = None, None
    for start in range(len(lw)):
        if lw[start] not in tset:
            continue  # a match starts on a dictated word (or its replacement's neighbour)
        matcher = difflib.SequenceMatcher(None, tl, lw[start:start + span], autojunk=False)
        blocks = [b for b in matcher.get_matching_blocks() if b.size]
        score = sum(b.size for b in blocks)
        if score < 0.6 * size:
            continue
        first, last = blocks[0], blocks[-1]
        begin = start + max(0, first.b - first.a)
        end = min(len(words), start + last.b + last.size + (size - last.a - last.size))
        if end <= begin or end - begin > size + size // 2 + 3:
            continue
        lo_c, hi_c = found[begin].start(), found[end - 1].end()
        distance = 0 if lo_c <= caret <= hi_c else min(abs(caret - lo_c), abs(caret - hi_c))
        key = (-distance, score)
        if best_key is None or key > best_key:
            best_key, best = key, words[begin:end]
    return best


def log(message):
    """One line in xhisper's log (`xhisper --log`). Never the dictated text:
    only what was watched, which words were seen as fixes and learned."""
    try:
        with open(os.path.join(RUNTIME_DIR, "xhisper.log"), "a", encoding="utf-8") as f:
            f.write(time.strftime("[%H:%M:%S] ") + "Learn: " + message + "\n")
    except OSError:
        pass


def watch(pasted):
    target = tokenize(pasted)
    if not target:
        return
    try:
        reader = open_reader()
    except (ImportError, ValueError):
        log(READER_UNAVAILABLE)
        return
    try:
        time.sleep(0.3)  # let the paste land
        if not reader.attach():
            if getattr(reader, "denied", False):
                log("Xhisper.app lacks Accessibility (System Settings > Privacy & Security > Accessibility), not watching")
            else:
                log("no readable text field in the focused window, not watching")
            return
        log("watching a %s for %ds" % (reader.role(), WATCH_SECONDS))
        follow(reader, target)
    finally:
        reader.close()


def follow(reader, target):
    pending, since, seen, done = [], 0.0, 0, set()
    located, first_find = False, True
    deadline = time.time() + WATCH_SECONDS
    while time.time() < deadline:
        time.sleep(POLL_SECONDS)
        got = reader.read()
        if got is None:
            log("field went away")
            return
        text, caret = got
        region = locate(target, text, caret)
        if region is None:
            # The dictation left the field with a fix pending: most likely it
            # was sent (Enter in a chat or terminal prompt) right after the fix,
            # before it could settle. Keep it only if it was seen on two polls
            # in a row, so a word caught half-typed is never learned.
            if pending and seen >= 2:
                log("text left the field (sent?) with fix pending: " + ", ".join(pending))
                learned = add_words(pending)
                log("learned: " + (", ".join(learned) or "nothing new"))
                announce(learned)
                done.update(pending)
            elif pending:
                log("text left the field before the fix was stable, not learned")
            pending, seen = [], 0
            if located:
                log("lost track of the dictation")
                located = False
            continue
        if not located:
            log("found the dictation in the field")
            located = True
            if first_find:
                # What already differs on the first look is how the paste
                # landed (glued to the word before it: "goes.Ok"), not a fix.
                first_find = False
                done.update(corrections(target, region))
        found = [w for w in corrections(target, region) if w not in done]
        if found != pending:
            pending, since, seen = found, time.time(), 1
            if found:
                log("fix seen: " + ", ".join(found))
            continue
        seen += 1
        if pending and time.time() - since >= SETTLE_SECONDS:
            learned = add_words(pending)
            log("learned: " + (", ".join(learned) or "nothing new"))
            announce(learned)
            done.update(pending)
            pending, seen = [], 0
    log("done watching")


CONTEXT_CHARS = 600
# Terminal and TUI chrome (box drawing, block elements, prompt arrows) carries
# no words; dropping it keeps the context short.
CHROME_RE = re.compile(r"[\u2500-\u259f\u276f\u23f5\u2190-\u21ff\ufffc]+")


def context():
    """Up to CONTEXT_CHARS of readable text before the caret, or nothing."""
    try:
        reader = open_reader()
    except (ImportError, ValueError):
        return ""
    try:
        text = reader.before_caret(4 * CONTEXT_CHARS) if reader.attach() else ""
    finally:
        reader.close()
    text = CHROME_RE.sub(" ", text)
    text = re.sub(r"[ \t\xa0]+", " ", text)
    text = re.sub(r"\s*\n\s*", "\n", text).strip()
    return text[-CONTEXT_CHARS:]


# A dictation pasted right after a word gets a leading space ("goes." + "Ok"
# must not become "goes.Ok"), except after whitespace or an opening bracket or
# quote, and never before text that starts with punctuation.
NO_SPACE_AFTER = "([{\"'\u201c\u2018\u00ab\u00bf\u00a1/"
NO_SPACE_BEFORE = ".,;:!?)]}\u201d\u2019\u00bb%\u2026"


def needs_space(before, text):
    return (bool(before) and bool(text) and not before.isspace() and before not in NO_SPACE_AFTER
            and not text[0].isspace() and text[0] not in NO_SPACE_BEFORE)


def caret_state():
    """"C" + the character before the caret in a readable field ("C" alone at
    its start), "E" for a readable but empty field, "U" when unreadable."""
    try:
        reader = open_reader()
    except (ImportError, ValueError):
        return "U"
    try:
        if not reader.attach():
            return "U"
        return "E" if reader.is_empty() else "C" + reader.before_caret(1)
    finally:
        reader.close()


# Where a field cannot be read (cmux's terminal exposes an always-empty text
# area), fall back on our own last paste: same app, recent, so the cursor is
# most likely still right after it. Only its last character is kept.
LAST_PASTE_FILE = os.path.join(RUNTIME_DIR, "last-paste.json")
LAST_PASTE_SECONDS = 120


def leading_space(state, text, terminal, app, last, now):
    if state.startswith("C"):
        return needs_space(state[1:], text)
    if state == "E" and not terminal:
        return False  # a really empty field; a terminal is never empty
    if not last or not app or last.get("app") != app:
        return False
    if not 0 <= now - last.get("time", 0) <= LAST_PASTE_SECONDS:
        return False
    return needs_space(last.get("last", ""), text)


def spacing(state, terminal, app, text):
    """Decide the leading space, then remember this paste for the fallback."""
    try:
        with open(LAST_PASTE_FILE, encoding="utf-8") as f:
            last = json.load(f)
    except (OSError, ValueError):
        last = None
    now = time.time()
    space = leading_space(state, text, terminal, app, last, now)
    pasted = (" " if space else "") + text
    if pasted:
        try:
            fd = os.open(LAST_PASTE_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump({"time": now, "app": app, "last": pasted[-1]}, f)
        except OSError:
            pass
    return space


def claim_watch_slot():
    """One watcher at a time: a new dictation replaces the previous watcher."""
    try:
        with open(WATCH_PID_FILE) as f:
            old = int(f.read().strip())
        if old != os.getpid():
            os.kill(old, 15)
    except (OSError, ValueError):
        pass
    try:
        with open(WATCH_PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def release_watch_slot():
    try:
        with open(WATCH_PID_FILE) as f:
            if int(f.read().strip()) == os.getpid():
                os.unlink(WATCH_PID_FILE)
    except (OSError, ValueError):
        pass


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "add":
        for w in add_words(args):
            print(w)
    elif cmd == "remove":
        for w in remove_words(args):
            print(w)
    elif cmd == "list":
        for w in load_dictionary():
            print(w)
    elif cmd == "diff":
        data = json.load(sys.stdin)
        learned = add_words(corrections(tokenize(data.get("old", "")), tokenize(data.get("new", ""))))
        for w in learned:
            print(w)
    elif cmd in ("context", "before"):
        if sys.platform == "darwin":
            # No `timeout` binary on macOS: never hold up a dictation over 2 s.
            signal.signal(signal.SIGALRM, lambda *_: os._exit(0))
            signal.alarm(2)
        sys.stdout.write(context() if cmd == "context" else caret_state())
    elif cmd == "spacing":
        # stdin: caret state (from `before`), NUL, 1 if terminal, NUL, app id, NUL, the dictation.
        parts = sys.stdin.buffer.read().decode("utf-8", "replace").split("\0", 3)
        state, terminal, app, text = (parts + ["", "", "", ""])[:4]
        sys.stdout.write("space" if spacing(state, terminal == "1", app, text) else "")
    elif cmd == "watch":
        pasted = sys.stdin.read()
        claim_watch_slot()
        try:
            watch(pasted)
        finally:
            release_watch_slot()
    else:
        print(f"xhisper-learn: unknown command '{cmd}'", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
