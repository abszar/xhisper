# xhisper configuration
# Copy to ~/.config/xhisper/xhisperrc and customize
# When in doubt, check by running 'xhisper --log'
#
# Syntax: key : value
# A "#" starts a comment anywhere on the line. Quote the value if it must
# contain a "#" — for example: transcription-prompt : "C# and F#"

# Transcription Settings:
long-recording-threshold : 1000
transcription-prompt     : ""

# Language:
# Leave empty to let Whisper auto-detect the spoken language (English, French,
# Spanish, etc. are all transcribed in their own script). Set to an ISO 639-1
# code (en, fr, de, es, ar, ...) to force a specific language instead.
language                 : ""

# Recording:
# Hard cap on a single recording, in seconds. Protects against a stuck key.
# 'xhisper --stop' ends a live recording; bind it to a second key for a stop
# shortcut. Pressing the dictation hotkey again does nothing, on purpose.
max-recording-seconds    : 300

# Sounds. Any file paplay/afplay can play, e.g. /usr/share/sounds/freedesktop/stereo/
# (Linux) or /System/Library/Sounds/ (macOS). Escape cancels a recording.
# Leave a key out for the default (silent on Linux; Tink, Pop, Basso and Glass
# on macOS); set it to an empty value to silence it.
# start-sound   : /System/Library/Sounds/Tink.aiff
# stop-sound    : /System/Library/Sounds/Pop.aiff
# cancel-sound  : /System/Library/Sounds/Basso.aiff
# learned-sound : /System/Library/Sounds/Glass.aiff   # with the "Learned: WORD" pill (see learn-words)

# History:
# Number of past dictations kept for 'xhisper --history' and the History chip
# on the overlay (0 = keep none). Stored 0600 in ~/.local/state/xhisper/.
history-size             : 20

# Linux: size of the History window and its text, 1 = the design's pixels.
# Empty follows GNOME's text scaling (1.25 with Large Text), like other apps.
history-scale            :

# Learning:
# After each paste, follow the text field for a minute (AT-SPI on Linux, the
# Accessibility API on macOS) and learn the words you correct in it - e.g. fix "to Ziam" into
# "TOSIAM" once and it goes into dictionary.txt. Only replaced words that are
# not ordinary English are learned, and lowercase ones only when the fix is a
# real change of word, not a typo or accent fix. Editing a
# dictation in the History window teaches the same way. Reads the focused
# field's text in memory only; nothing is stored but the learned words.
learn-words              : false

# Screen context (like Wispr Flow): send the ~600 characters just before the
# cursor (read through AT-SPI or the Accessibility API) with the auto-edit request, so names already on
# screen are spelled the same way - "cloud code" becomes "Claude Code" when that
# is visible. That text goes to the LLM provider along with the dictation.
screen-context           : false

# Smart spacing: when the cursor sits right after a word or a full stop, the
# dictation is pasted with a leading space ("goes." + "Ok" stays "goes. Ok").
# Reads only the one character before the cursor (AT-SPI / Accessibility API).
smart-spacing            : true

# Silence Detection:
# Recordings whose peak volume stays under this many dB are discarded.
silence-threshold        : -50
# ...and so are those with less than this many seconds of speech-like sound
# (a hotkey click alone made Whisper write "Thank you."). 0 turns it off.
min-speech-seconds       : 0.3

# AI Auto-editing:
# Removes filler words, stutters and false starts, applies spoken self-corrections
# ("Tuesday, no wait, Wednesday"), and fixes punctuation. It never rewrites your
# wording; if the model returns something suspicious, the raw transcription is
# pasted instead.
auto-edit                : true

# Tone Adaptation:
# Detects the active window and lets it influence punctuation and formatting
# (chat vs email vs code editor). It never changes your wording or length.
tone-adaptation          : true

# Personal Dictionary:
# Add custom words/names to ~/.config/xhisper/dictionary.txt (one per line)
# to improve Whisper's recognition accuracy for domain-specific terms.

# API Endpoints:
# By default, xhisper uses Groq's API (requires GROQ_API_KEY in ~/.env).
# You can point STT and LLM to any OpenAI-compatible endpoint — including local servers.
#
# Speech-to-text (Whisper):
# stt-url     : https://api.groq.com/openai/v1
# stt-api-key :
# stt-model   :
# stt-timeout : 90            # seconds before the request is given up on
#
# LLM (auto-edit):
# llm-url     : https://api.groq.com/openai/v1
# llm-api-key :
# llm-model   : qwen/qwen3.8-27b  # Groq retires models: if auto-edit is always rejected, check xhisper --log
# llm-timeout : 30            # seconds before the raw transcription is pasted instead
#
# Local Whisper example (whisper.cpp server):
# stt-url     : http://localhost:8080/v1
# stt-api-key :
# stt-model   : whisper-1
#
# Local LLM example (Ollama):
# llm-url     : http://localhost:11434/v1
# llm-api-key :
# llm-model   : llama3
