        self.new_chip.connect("clicked", lambda *_: self.scroll_to_top())
        self.new_chip.set_no_show_all(True)
        overlay.add_overlay(self.new_chip)

        # Toasts, 12 above the footer.
        self.toast_slot = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.END)
        self.toast_slot.set_margin_bottom(32 + 12)
        overlay.add_overlay(self.toast_slot)
        overlay.set_overlay_pass_through(self.toast_slot, False)

    def make_empty(self):
        """A6: seven bars, title, one line of help; centred, raised 22."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        box.set_margin_bottom(44)
        bars = bars_widget([6, 10, 15, 20, 15, 10, 6], 4, 3, 2, ink_rgba(0.35), 28)
        bars.set_halign(Gtk.Align.CENTER)
        bars.set_margin_bottom(8)
        box.pack_start(bars, False, False, 0)
        box.pack_start(label("No dictations yet", "empty-title", xalign=0.5), False, False, 0)
        body = label("Hold your dictation hotkey and speak. Your last %d dictations will show up here."
                     % history_size(), "empty-body", xalign=0.5)
