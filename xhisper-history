# ----- Motion ----------------------------------------------------------------

class Curve:
    """A CSS cubic-bezier timing curve: maps elapsed fraction to progress."""

    def __init__(self, x1, y1, x2, y2):
        self.x1, self.y1, self.x2, self.y2 = x1, y1, x2, y2

    @staticmethod
    def _bezier(u, a, b):
        v = 1 - u
        return 3 * v * v * u * a + 3 * v * u * u * b + u * u * u

    def __call__(self, t):
        if t <= 0:
            return 0.0
        if t >= 1:
            return 1.0
        lo, hi, u = 0.0, 1.0, t
        for _ in range(40):
            x = self._bezier(u, self.x1, self.x2)
            if abs(x - t) < 1e-6:
                break
            if x < t:
                lo = u
            else:
                hi = u
            u = (lo + hi) / 2
        return self._bezier(u, self.y1, self.y2)


CURVE_OUT = Curve(0.16, 1, 0.3, 1)
CURVE_IN = Curve(0.4, 0, 1, 1)
CURVE_STD = Curve(0.2, 0, 0, 1)


class Tween:
    """One animation on the GLib clock: `step` gets the eased progress 0..1."""

    def __init__(self, duration, curve, step, done=None, delay=0.0):
        self.start = time.monotonic() + delay
        self.duration, self.curve, self.step, self.done = duration, curve, step, done
        self.source = None
        step(0.0)
        self.source = GLib.timeout_add(16, self.tick)

    def tick(self):
        p = (time.monotonic() - self.start) / self.duration if self.duration > 0 else 1
        if p < 0:
            return True  # still in the delay
        self.step(self.curve(p))
        if p >= 1:
            self.source = None
            if self.done:
                self.done()
            return False
        return True

    def stop(self):
        if self.source:
            GLib.source_remove(self.source)
            self.source = None


