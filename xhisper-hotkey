#!/usr/bin/env python3

# xhisper-hotkey - modifier-only dictation trigger (X11)
# Press Alt, then Ctrl, to start recording; press Alt then Ctrl again to stop.
# Each press runs `xhisper --toggle`.
#
# GNOME custom shortcuts need a non-modifier key, so "Alt then Ctrl" cannot be
# bound there. This listener asks the X server for a passive grab on Control_L
# and Control_R *with Alt (Mod1) already down*, so the server enforces the
# order itself: Ctrl then Alt never matches, and plain Ctrl is untouched.
# When another client holds the keyboard (Deskflow while the cursor is on the
# other machine, a game, a lock screen) the grab cannot fire, which is what
# we want.
#
# Double tap: a second Alt+Ctrl within 0.5 s of one that started a recording
# opens the History window instead of toggling (the recording it started is
# cancelled through the History flag, and its pill rises into the window).
#
# Started at login from ~/.config/autostart/xhisper-hotkey.desktop.
# Only one instance runs per session (flock on the runtime dir).

import ctypes
import fcntl
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from ctypes import c_char, c_char_p, c_int, c_uint, c_ulong, c_void_p

XK_CONTROL_L = 0xffe3
XK_CONTROL_R = 0xffe4
LOCK_MASK = 1 << 1   # Caps Lock
MOD1_MASK = 1 << 3   # Alt
MOD2_MASK = 1 << 4   # Num Lock
KEY_PRESS = 2
GRAB_MODE_ASYNC = 1
CURRENT_TIME = 0
DOUBLE_TAP_SECONDS = 0.5
PIPELINE_MAX_AGE = 1800  # past this an xhisper.pid names a wedged run, not a live one


def runtime_dir():
    """Same rule as xhisper.sh: XHISPER_RUNTIME_DIR, else XDG_RUNTIME_DIR/xhisper."""
    return os.environ.get("XHISPER_RUNTIME_DIR") or os.path.join(
        os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "xhisper")


def sibling(name):
    """A helper next to us (checkout) or the installed one."""
    path = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), name)
    return path if os.access(path, os.X_OK) else (shutil.which(name) or "/usr/local/bin/" + name)


def live_pid(path, needle):
    """The pid in `path` ("PID [EPOCH]") when it is alive and running `needle`."""
    try:
        with open(path) as f:
            parts = f.read().split()
        pid = int(parts[0])
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if needle.encode() not in f.read():
                return None
        if len(parts) > 1 and time.time() - float(parts[1]) > PIPELINE_MAX_AGE:
            return None
        return pid
    except (OSError, ValueError, IndexError):
        return None


class DoubleTap:
    """Two combos in quick succession open History: the second within
    DOUBLE_TAP_SECONDS of a first that started a recording. A combo that
    stopped a recording never starts a double tap, so a quick stop-then-start
    still records. Times come from a monotonic clock."""

    def __init__(self):
        self.started_at = None

    def fired(self, now, recording_live):
        if self.started_at is not None and now - self.started_at <= DOUBLE_TAP_SECONDS:
            self.started_at = None
            return True
        self.started_at = None if recording_live else now
        return False


def open_history(runtime):
    """Drop the History flag, as the pill's History chip does: the recording
    the first tap started cancels on it, and its pill rises into the window.
    The run may still be starting (it clears stale flags), so the flag is
    written again while it lives; and with no window after 1.2 s (no pill
    took it), open the window ourselves."""
    flag = os.path.join(runtime, "xhisper.history")
    pidfile = os.path.join(runtime, "xhisper.pid")

    def drop():
        try:
            os.close(os.open(flag, os.O_WRONLY | os.O_CREAT, 0o600))
        except OSError:
            pass

    def again():
        if live_pid(pidfile, "xhisper") and not os.path.exists(flag):
            drop()

    def fallback():
        if live_pid(os.path.join(runtime, "xhisper-history.pid"), "xhisper-history"):
            return
        print("xhisper-hotkey: no History window from the pill, opening it", file=sys.stderr)
        try:
            subprocess.Popen([sibling("xhisper-history")], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass

    drop()
    for delay, action in ((0.3, again), (0.6, again), (1.2, fallback)):
        timer = threading.Timer(delay, action)
        timer.daemon = True
        timer.start()


def fail(msg):
    print(f"xhisper-hotkey: {msg}", file=sys.stderr)
    sys.exit(1)


def single_instance():
    runtime = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    lock = open(os.path.join(runtime, 'xhisper-hotkey.lock'), 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)  # already running in this session
    return lock


def main():
    if os.environ.get('XDG_SESSION_TYPE') == 'wayland':
        fail("Wayland is not supported; bind xhisper in your desktop's shortcut settings instead")

    xhisper = os.environ.get('XHISPER_CMD') or shutil.which('xhisper') or '/usr/local/bin/xhisper'
    runtime = runtime_dir()
    double_tap = DoubleTap()
    _lock = single_instance()

    try:
        X11 = ctypes.cdll.LoadLibrary('libX11.so.6')
    except OSError:
        fail("libX11 missing")
    X11.XOpenDisplay.restype = c_void_p
    X11.XOpenDisplay.argtypes = [c_char_p]
    X11.XDefaultRootWindow.restype = c_ulong
    X11.XDefaultRootWindow.argtypes = [c_void_p]
    X11.XKeysymToKeycode.restype = ctypes.c_ubyte
    X11.XKeysymToKeycode.argtypes = [c_void_p, c_ulong]
    X11.XGrabKey.argtypes = [c_void_p, c_int, c_uint, c_ulong, c_int, c_int, c_int]
    X11.XUngrabKeyboard.argtypes = [c_void_p, c_ulong]
    X11.XNextEvent.argtypes = [c_void_p, c_void_p]
    X11.XPending.argtypes = [c_void_p]
    X11.XQueryKeymap.argtypes = [c_void_p, c_void_p]
    X11.XSync.argtypes = [c_void_p, c_int]
    X11.XFlush.argtypes = [c_void_p]

    # A grab that someone else already holds fails with BadAccess, reported
    # asynchronously; record it instead of letting Xlib exit the process.
    grab_errors = []
    handler_type = ctypes.CFUNCTYPE(c_int, c_void_p, c_void_p)

    def on_error(_display, _event):
        grab_errors.append(1)
        return 0
    error_handler = handler_type(on_error)
    X11.XSetErrorHandler(error_handler)

    display = X11.XOpenDisplay(None)
    if not display:
        fail("cannot open the X display")
    root = X11.XDefaultRootWindow(display)

    keycodes = [X11.XKeysymToKeycode(display, k) for k in (XK_CONTROL_L, XK_CONTROL_R)]
    keycodes = [k for k in keycodes if k]
    if not keycodes:
        fail("no Control key in the keymap")

    # Caps Lock / Num Lock are part of the modifier state, so grab every
    # combination or the shortcut silently dies when Num Lock is on.
    for keycode in keycodes:
        for locks in (0, LOCK_MASK, MOD2_MASK, LOCK_MASK | MOD2_MASK):
            X11.XGrabKey(display, keycode, MOD1_MASK | locks, root, 0,
                         GRAB_MODE_ASYNC, GRAB_MODE_ASYNC)
    X11.XSync(display, 0)
    if grab_errors:
        fail("Alt+Ctrl is already grabbed by another program")

    # Children are fire-and-forget; let the kernel reap them.
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)

    keymap = (c_char * 32)()

    def ctrl_held():
        X11.XQueryKeymap(display, keymap)
        return any(ord(keymap[k // 8]) & (1 << (k % 8)) for k in keycodes)

    def drain():
        # A passive grab turns into a full keyboard grab until the key is
        # released. Drop it at once so Alt-first shortcuts such as
        # Ctrl+Alt+T keep reaching the desktop.
        while X11.XPending(display):
            X11.XNextEvent(display, event)
        X11.XUngrabKeyboard(display, CURRENT_TIME)
        X11.XFlush(display)

    event = ctypes.create_string_buffer(192)  # sizeof(XEvent)
    print(f"xhisper-hotkey: press Alt then Ctrl to start/stop dictation ({xhisper})", file=sys.stderr)
    while True:
        X11.XNextEvent(display, event)
        if ctypes.cast(event, ctypes.POINTER(c_int))[0] != KEY_PRESS:
            continue
        X11.XUngrabKeyboard(display, CURRENT_TIME)
        X11.XFlush(display)
        live = live_pid(os.path.join(runtime, 'xhisper.pid'), 'xhisper') is not None
        if double_tap.fired(time.monotonic(), live):
            open_history(runtime)
        else:
            subprocess.Popen([xhisper, '--toggle'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        # One launch per press: Ctrl auto-repeats while held, and each repeat
        # re-fires the grab. In toggle mode a repeat would stop the recording
        # it just started, so this debounce is required, not an optimisation.
        while ctrl_held():
            drain()
            time.sleep(0.03)
        drain()


if __name__ == '__main__':
    main()
