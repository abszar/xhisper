# Fresh pills that carry the History chip (one updated in place keeps the chip
# it had while recording). On "recording" a click also cancels the dictation
# (via XHISPER_HISTORYFLAG, polled by xhisper.sh).
HISTORY_STATES = ("recording", "silent", "error", "cancelled")
# States that update the pill already on screen instead of replacing it: one
# pill per dictation (user, 2026-10-14: "too many pop-ups"; a pill that shrank
# into a second look was not liked either). The recording pill keeps its size,
# place and History chip; its text and bars change. done just lets it go, no
# Done pill. learned still replaces it, and silent/error/cancelled do when no
# dictation pill is there to take them (the pill answers in ACK_FILE).
IN_PLACE_STATES = ("transcribing", "editing", "done", "silent", "error", "cancelled")
ACKED_STATES = ("silent", "error", "cancelled")
# Pills that a later stage of their own dictation may update, and into what.
UPDATABLE_STATES = ("recording", "transcribing", "editing")
FOLLOW_STATES = ("transcribing", "editing", "done", "silent", "error", "cancelled")
WAVE_STATES = ("transcribing", "editing")

# Motion (design B2), seconds and pixels.
ENTRY_SLIDE, ENTRY_SECONDS, ENTRY_FADE_SECONDS = 60, 0.36, 0.24
EXIT_SLIDE, EXIT_SECONDS = 16, 0.32
LAUNCH_RISE, LAUNCH_SECONDS = 24, 0.28   # pill-to-window
LABEL_SECONDS, LABEL_LIFT = 0.18, 4
CHIP_HOVER_SECONDS = 0.08
WAVE_PERIOD, WAVE_LENGTH, WAVE_MID, WAVE_AMP = 1.6, 10.0, 12, 4
DOT_PERIOD, DOT_STEP = 1.2, 0.2
FLAG_POLL_SECONDS = 0.05
IDLE_SHAPE = [0.30, 0.85, 0.30, 0.90, 0.55, 0.80, 0.95, 0.35,
              0.60, 0.95, 0.80, 0.25, 0.85, 0.90, 0.55, 0.30, 0.50]

