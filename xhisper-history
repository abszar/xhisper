    # ----- drawing, shape, resize ----------------------------------------------

    def set_opacity(self, value):
        Gtk.Widget.set_opacity(self, value)  # Gtk.Window's own is deprecated

    def get_opacity(self):
        return Gtk.Widget.get_opacity(self)

    def card_rect(self):
        alloc = self.get_allocation()
        return (self.margin, self.margin, alloc.width - 2 * self.margin, alloc.height - 2 * self.margin)

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        x, y, w, h = self.card_rect()
        r = RADIUS if self.composited else 0
        if self.composited:
            # The window's shadow (0 12 32 black 0.45 on macOS), as stacked outlines.
            steps = 16
            for k in range(steps):
                spread = SHADOW * (1 - k / steps)
                self.rounded(cr, x - spread / 2, y + 8 - spread / 2, w + spread, h + spread, r + spread / 2)
                cr.set_source_rgba(0, 0, 0, 0.45 / steps * 1.4)
                cr.fill()
        self.rounded(cr, x, y, w, h, r)
        cr.set_source_rgba(*SURFACE)
        cr.fill()
        self.rounded(cr, x + 0.5, y + 0.5, w - 1, h - 1, max(0, r - 0.5))
        cr.set_source_rgba(*EDGE)
        cr.set_line_width(1)
        cr.stroke()
        return False

    @staticmethod
    def rounded(cr, x, y, w, h, r):
        r = max(0, min(r, w / 2, h / 2))
        cr.new_path()
        if r == 0:
            cr.rectangle(x, y, w, h)
            return
        cr.arc(x + r, y + r, r, 3.14159265, 4.71238898)
        cr.arc(x + w - r, y + r, r, -1.5707963, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.5707963)
        cr.arc(x + r, y + h - r, r, 1.5707963, 3.14159265)
        cr.close_path()

    def on_size_allocate(self, _w, _alloc):
        """Clicks on the shadow go through to the windows below."""
        window = self.get_window()
        if window is None or not self.margin:
            return
        x, y, w, h = self.card_rect()
        if getattr(self, "_shape", None) == (w, h):
            return
        self._shape = (w, h)
        self.input_shape_combine_region(cairo.Region(cairo.RectangleInt(x, y, w, h)))

    def on_configure(self, *_):
        """A resize ended: keep the size (only the size: the position is
        recomputed on every open)."""
        if self.resizing:
            if self.save_source:
                GLib.source_remove(self.save_source)
            self.save_source = GLib.timeout_add(400, self.resize_settled)
        return False

    def resize_settled(self):
        self.save_source = None
        self.resizing = False
        self.save_size()
        return False

    def edge_at(self, wx, wy):
        """The resize edge under a window point (6 px bands inside the card,
        corners 19 long), as a Gdk.WindowEdge, or None."""
        x, y, w, h = self.card_rect()
        px, py = wx - x, wy - y
        if px < 0 or py < 0 or px > w or py > h:
            return None
        left, right, top, bottom = px < GRAB, px > w - GRAB, py < GRAB, py > h - GRAB
        if left or right:
            if py < CORNER_SPAN:
                top = True
            elif py > h - CORNER_SPAN:
                bottom = True
        if top or bottom:
            if px < CORNER_SPAN:
                left = True
            elif px > w - CORNER_SPAN:
                right = True
        E = Gdk.WindowEdge
        table = {(True, False, True, False): E.NORTH_WEST, (False, True, True, False): E.NORTH_EAST,
                 (True, False, False, True): E.SOUTH_WEST, (False, True, False, True): E.SOUTH_EAST,
                 (True, False, False, False): E.WEST, (False, True, False, False): E.EAST,
                 (False, False, True, False): E.NORTH, (False, False, False, True): E.SOUTH}
        return table.get((left, right, top, bottom))

    CURSORS = {"NORTH_WEST": "nw-resize", "NORTH_EAST": "ne-resize", "SOUTH_WEST": "sw-resize",
               "SOUTH_EAST": "se-resize", "WEST": "w-resize", "EAST": "e-resize",
               "NORTH": "n-resize", "SOUTH": "s-resize"}

    def window_point(self, _widget, event):
        """The event in window coordinates (it may come from a child's own GdkWindow)."""
        window = self.get_window()
        if window is None:
            return event.x, event.y
        _ok, ox, oy = window.get_origin()
        return event.x_root - ox, event.y_root - oy

    def on_edge_motion(self, widget, event):
        wx, wy = self.window_point(widget, event)
        edge = self.edge_at(wx, wy)
        name = self.CURSORS.get(edge.value_nick.upper().replace("-", "_")) if edge is not None else None
        gdk_window = self.get_window()
        if gdk_window is not None and name != getattr(self, "_cursor", None):
            self._cursor = name
            gdk_window.set_cursor(Gdk.Cursor.new_from_name(self.get_display(), name) if name else None)
        return False

    def try_resize(self, widget, event):
        if event.button != 1 or event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        edge = self.edge_at(*self.window_point(widget, event))
        if edge is None:
            return False
        self.resizing = True
        self.begin_resize_drag(edge, event.button, int(event.x_root), int(event.y_root), event.time)
        return True

    def on_edge_press(self, widget, event):
        return self.try_resize(widget, event)

    def on_header_press(self, widget, event):
        if self.try_resize(widget, event):
            return True
        if event.button == 1 and event.type == Gdk.EventType.BUTTON_PRESS:
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        return False

    def on_footer_press(self, widget, event):
        return self.try_resize(widget, event)

    # ----- list ------------------------------------------------------------------

    def populate(self):
        """The whole list from the file, the Enter target on the newest."""
        self.rebuild(load_entries(), keep_place=False)

    def rebuild(self, entries, keep_place):
        if self.editing:
            self.stale = True  # don't wipe an edit in progress
            return
        self.cancel_copy_close()
        y = self.vadj.get_value()
        moved = self.entries[self.target_index] if (keep_place and 0 < self.target_index < len(self.entries)) else None
        expanded = {r.entry for r in self.rows if r.expanded} if keep_place else set()
        for child in self.list.get_children():
            self.list.remove(child)
        self.entries = entries
        self.target_index = entries.index(moved) if moved in entries else 0
        self.rows = []
        for i, entry in enumerate(entries):
            row = self.make_row(entry, i)
            if entry in expanded:
                row.expanded = True
            self.rows.append(row)
            self.list.pack_start(row, False, False, 0)
        self.stack.set_visible_child_name("list" if entries else "empty")
        if keep_place and entries:
            GLib.idle_add(lambda: self.vadj.set_value(y) or False)
        else:
            self.hide_new_chip()
        self.update_footer()

    def make_row(self, entry, index):
        """Actions Edit · Copy · Paste, the primary capsule last: Paste when a
        text field waits for it, else Copy."""
        row = Row(entry, index, self)
        edit = RowButton("icon", icon_name="document-edit-symbolic", tooltip="Edit")
        edit.connect("clicked", lambda *_: self.edit_entry(row))
        if self.target is not None:
            copy = RowButton("icon", icon_name="edit-copy-symbolic", tooltip="Copy")
            paste = RowButton("primary", "Paste", tooltip="Paste into %s" % app_name(self.target["class"]))
            paste.connect("clicked", lambda *_: self.paste_entry(row.index))
            row.set_actions([edit, copy, paste])
            row.primary = paste
        else:
            copy = RowButton("primary", "Copy", tooltip="Copy")
            row.set_actions([edit, copy])
            row.primary = copy
        copy.connect("clicked", lambda *_: self.copy_entry(row.index))
        row.copy_button = copy
        row.is_target = index == self.target_index
        row.refresh(False)
        row.apply_clamp()
        return row

    def refresh_actions(self):
        """The paste target changed (a raise): rebuild the rows' buttons."""
        self.rebuild(self.entries, keep_place=True)

    def refresh_times(self):
        for row in self.rows:
            row.refresh_time()
        return True

    def update_footer(self):
        """What ↩ does, and esc; the editor's keys while editing."""
        if self.editing:
            self.set_hints([("↩", "Save"), ("⇧↩", "New line")], ("esc", "Cancel"))
            return
        hints = []
        if self.entries:
            which = "newest " if self.target_index == 0 else ""
            if self.target is not None:
                hints.append(("↩", "Paste %sin %s" % (which, app_name(self.target["class"]))))
            else:
                hints.append(("↩", "Copy newest" if self.target_index == 0 else "Copy"))
        self.set_hints(hints, ("esc", "Close"))

    def set_hints(self, hints, trailing):
        for box in (self.hints, self.trailing_hint):
            for child in box.get_children():
                box.remove(child)
        for key, text in hints:
            self.hints.pack_start(self.hint(key, text), False, False, 0)
        if trailing:
            self.trailing_hint.pack_start(self.hint(*trailing), False, False, 0)
        self.hints.show_all()
        self.trailing_hint.show_all()

    @staticmethod
    def hint(key, text):
        box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        cap = label(key, "keycap", xalign=0.5)
        cap.set_valign(Gtk.Align.CENTER)
        box.pack_start(cap, False, False, 0)
        hint = label(text, "hint")
        hint.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(hint, False, False, 0)
        return box

    def on_scrolled(self, adj):
        scrolled = adj.get_value() > 0.5
        if scrolled != self.header_scrolled:
            self.header_scrolled = scrolled
            start, end = self.header_sep.get_opacity(), 1.0 if scrolled else 0.0
            Tween(0.12, Curve(0, 0, 1, 1), lambda e: self.header_sep.set_opacity(start + (end - start) * e))
        if not scrolled:
            self.hide_new_chip()

    # ----- live arrival (A7) --------------------------------------------------

    def on_file_changed(self, _monitor, _file, _other, event):
        if event not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                         Gio.FileMonitorEvent.DELETED, Gio.FileMonitorEvent.RENAMED,
                         Gio.FileMonitorEvent.MOVED_IN):
            return
        if not self.refresh_pending:
            self.refresh_pending = True
            GLib.timeout_add(120, self.refresh_from_file)

    def refresh_from_file(self):
        self.refresh_pending = False
        if self.editing:
            self.stale = True
            return False
        self.stale = False
        file = load_entries()
        change = arrival(self.entries, file)
        if change[0] == "rebuild":
            self.rebuild(file, keep_place=True)
        elif change[0] == "insert":
            self.insert_arrivals(file, change[1], change[2])
        return False

    def insert_arrivals(self, file, count, keep):
        """`count` new rows on top, old rows past `keep` dropped. At the top
        of the list they slide open; scrolled down, the visible rows stay put
        and the "N new" chip counts them."""
        scrolled = self.vadj.get_value() > 0.5
        for row in self.rows[keep:]:
            self.list.remove(row.get_parent() if isinstance(row.get_parent(), Gtk.Revealer) else row)
        old = self.rows[:keep]
        for row in old:
            row.index += count
        moved = 0 < self.target_index < keep
        self.target_index = self.target_index + count if moved else 0
        self.entries = file
        before = self.list.get_allocated_height()
        added = []
        for i, entry in enumerate(file[:count]):
            row = self.make_row(entry, i)
            revealer = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                                    transition_duration=0 if (scrolled or self.reduce) else 220)
            revealer.add(row)
            self.list.pack_start(revealer, False, False, 0)
            self.list.reorder_child(revealer, i)
            revealer.show_all()
            added.append((row, revealer))
        self.rows = [r for r, _ in added] + old
        for row in old:
            if row.is_target != (row.index == self.target_index):
                row.set_target(row.index == self.target_index)
        for row, revealer in added:
            revealer.set_reveal_child(True)
            row.flash()
        if scrolled:
            # Keep the visible rows where they were: move the view by what grew above them.
            def keep_view(*_):
                grown = self.list.get_allocated_height() - before
                if grown > 0:
                    self.vadj.set_value(self.vadj.get_value() + grown)
                self.list.disconnect(handler)
            handler = self.list.connect("size-allocate", keep_view)
            self.new_count += count
            self.show_new_chip()
        self.update_footer()

    def show_new_chip(self):
        self.new_chip_label.set_text("%d new" % self.new_count)
        if self.new_chip_shown:
            return
        self.new_chip_shown = True
        self.new_chip.show_all()
        rise = 0 if self.reduce else 4

        def step(e):
            self.new_chip.set_opacity(e)
            self.new_chip.set_margin_top(int(44 + 8 - rise * (1 - e)))
        Tween(0.16, CURVE_OUT, step)

    def hide_new_chip(self):
        self.new_count = 0
        if not self.new_chip_shown:
            return
        self.new_chip_shown = False
        alpha = self.new_chip.get_opacity()

        def done():
            if not self.new_chip_shown:
                self.new_chip.hide()
        Tween(0.16, CURVE_IN, lambda e: self.new_chip.set_opacity(alpha * (1 - e)), done)

    def scroll_to_top(self):
        start = self.vadj.get_value()
        self.hide_new_chip()
        Tween(0.2, CURVE_STD, lambda e: self.vadj.set_value(start * (1 - e)))

    def reveal(self, row):
        """Keep a row in view (4 px of the gap around it too)."""
        alloc = row.get_allocation()
        parent = row.get_parent()
        if isinstance(parent, Gtk.Revealer):
            alloc = parent.get_allocation()
        top, bottom = alloc.y - 4, alloc.y + alloc.height + 4
        value, page = self.vadj.get_value(), self.vadj.get_page_size()
        if top < value:
            self.vadj.set_value(max(0, top))
        elif bottom > value + page:
            self.vadj.set_value(bottom - page)

    # ----- keyboard (A9 §8) -----------------------------------------------------

    def on_key(self, _w, event):
        key = event.keyval
        mods = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
                              | Gdk.ModifierType.MOD1_MASK | Gdk.ModifierType.SUPER_MASK)
        if mods == Gdk.ModifierType.CONTROL_MASK and key in (Gdk.KEY_w, Gdk.KEY_W):
            self.close_animated()
            return True
        if self.editing:
            if key == Gdk.KEY_Escape:  # also when the field lost the focus
                self.finish_edit(False)
                return True
            return False  # the field has its own keys
        if mods:
            return False
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter):
            self.activate_target()
            return True
        if key == Gdk.KEY_Escape:
            self.close_animated()
            return True
        if key in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
            self.move_target(-1)
            return True
        if key in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
            self.move_target(1)
            return True
        return False

    def activate_target(self):
        """↩: Paste the target row; with nowhere to paste, Copy it and close
        500 ms after the check appears."""
        if self.closing or self.closing_after_copy or not (0 <= self.target_index < len(self.entries)):
            return
        if self.target is not None:
            self.paste_entry(self.target_index)
            return
        self.closing_after_copy = True

        def shown():
            if self.closing_after_copy:
                self.copy_close = GLib.timeout_add(500, self.copy_close_fire)
        self.copy_entry(self.target_index, shown)

    def copy_close_fire(self):
        self.copy_close = None
        self.close_animated()
        return False

    def cancel_copy_close(self):
        if self.copy_close:
            GLib.source_remove(self.copy_close)
            self.copy_close = None
        self.closing_after_copy = False

    def move_target(self, delta):
        if self.closing or not self.rows:
            return
        new = max(0, min(len(self.rows) - 1, self.target_index + delta))
        if new == self.target_index:
            return
        self.rows[self.target_index].set_target(False)
        self.target_index = new
        row = self.rows[new]
        row.set_target(True)
        GLib.idle_add(lambda: self.reveal(row) or False)
        GLib.timeout_add(60, lambda: self.reveal(row) or False)
        self.update_footer()

    # ----- copy, paste, edit ------------------------------------------------------

    def copy_entry(self, index, shown=None):
        if self.editing or self.closing or not (0 <= index < len(self.entries)):
            return
        copy_text(self.entries[index][1])
        button = self.rows[index].copy_button if index < len(self.rows) else None
        if button is not None:
            button.show_copied(shown)
        elif shown:
            shown()

    def paste_entry(self, index):
        """Paste (A9 §7): clipboard = the raw text, the window fades out in
        120 ms and hides, the target window gets the keys back, Ctrl+V goes
        to it, the old clipboard comes back 0.3 s later, then we quit."""
        log("paste clicked: row %d of %d, editing %s, closing %s, target %s"
            % (index, len(self.entries), self.editing is not None, self.closing,
               self.target["class"] if self.target else "none"))
        if self.editing or self.closing or self.target is None or not (0 <= index < len(self.entries)):
            return
        target = self.target
        text = self.entries[index][1]
        self.closing = self.pasting = True
        # Hiding the last window must not end the app before the keystroke.
        self.app.hold()
        if self.motion:
            self.motion.stop()
        alpha = self.get_opacity()
        start = time.monotonic()

        def faded():
            self.hide()
            wait = max(0.16 - (time.monotonic() - start), 0.04)
            GLib.timeout_add(int(wait * 1000), lambda: self.start_paste_thread(target, text) or False)
        self.motion = Tween(0.12, CURVE_IN, lambda e: self.set_opacity(alpha * (1 - e)), faded)

    def start_paste_thread(self, target, text):
        threading.Thread(target=self.send_paste, args=(target, text), daemon=True).start()

    def send_paste(self, target, text):
        # Runs on a worker thread: the clipboard must go through a CLI tool,
        # never copy_text()'s GTK fallback.
        if not clip_tool():
            log("paste: no xclip / wl-copy, cannot paste")
            GLib.idle_add(self.app.quit)
            return
        saved = read_clipboard()
        copy_text(text)
        wid = target["id"]
        run(["xdotool", "windowactivate", "--sync", wid], timeout=2)
        # The keystroke must not leave before the target really has the keys.
        deadline = time.monotonic() + 1.5
        while time.monotonic() < deadline:
            front = run(["xdotool", "getactivewindow"], timeout=1)
            if front == wid:
                break
            time.sleep(0.03)
        time.sleep(0.1)  # a moment for its widget to take the focus back
        # Never type into anything else: the keystroke goes to whatever has
        # the focus. The entry stays on the clipboard for a manual paste.
        front = run(["xdotool", "getactivewindow"], timeout=1)
        if front != wid:
            log("paste: %s is not the active window (gone, or the focus moved): no keystroke, "
                "the entry is left on the clipboard" % target["class"])
            GLib.idle_add(self.app.quit)
            return
        terminal = is_terminal_class(target["class"])
        ok = paste_keystroke(terminal)
        log("paste: %s into %s, %s" % ("Ctrl+Shift+V" if terminal else "Ctrl+V", target["class"],
                                      "keystroke sent" if ok else "keystroke failed"))
        time.sleep(0.3)  # the app reads the clipboard after the keystroke
        if saved is not None:
            copy_text(saved)
        GLib.idle_add(self.app.quit)

    def edit_entry(self, row):
        """A3 edit: the row's text becomes a field, its actions Cancel and
        Save, the other rows dim, the footer shows the editor's keys."""
        if self.editing or self.closing or row not in self.rows:
            return
        self.cancel_copy_close()
        self.dismiss_toast()
        cancel = RowButton("ghost", "Cancel")
        cancel.connect("clicked", lambda *_: self.finish_edit(False))
        save = RowButton("primary", "Save")
        save.connect("clicked", lambda *_: self.finish_edit(True))
        field = EditField(row.entry[1])
        field.view.connect("key-press-event", self.on_field_key)
        self.editing = (row.entry, field, row)
        row.enter_edit(field, [cancel, save])
        for other in self.rows:
            if other is not row:
                other.set_dimmed(True)
            other.refresh(True)
        self.update_footer()
        field.view.grab_focus()
        GLib.timeout_add(50, lambda: self.reveal(row) or False)

    def on_field_key(self, _view, event):
        """↩ Save, ⇧↩ (or Alt+↩) a new line, esc Cancel."""
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter):
            if event.state & (Gdk.ModifierType.SHIFT_MASK | Gdk.ModifierType.MOD1_MASK):
                buf = _view.get_buffer()
                buf.delete_selection(True, True)
                buf.insert_at_cursor("\n")
                return True
            self.finish_edit(True)
            return True
        if event.keyval == Gdk.KEY_Escape:
            self.finish_edit(False)
            return True
        return False

    def finish_edit(self, save):
        """Save or Cancel. A save writes the file first, then learns the
        changed words off the main thread; the toast says how it went. A
        failed write keeps the editor open (red border) so Retry can try again."""
        if not self.editing:
            return
        entry, field, row = self.editing
        new_text = field.text.strip()
        saved = None
        if save and new_text and new_text != entry[1]:
            self.dismiss_toast()
            if not update_history(entry, new_text):
                field.set_failed(True)
                self.show_toast("failed")
                return
            saved = new_text
            index = self.rows.index(row)
            self.entries[index] = (entry[0], new_text)
        elif self.toast_kind == "failed":
            self.dismiss_toast()
        self.editing = None
        row.leave_edit(saved)
        for other in self.rows:
            other.set_dimmed(False)
            other.refresh(True)
        self.update_footer()
        self.set_focus(None)
        if self.actions_stale:
            # Raised during the edit: the Paste target changed, rebuild the buttons.
            self.actions_stale = False
            self.rebuild(self.entries, keep_place=True)
        if self.stale:
            GLib.timeout_add(200, self.refresh_from_file)
        if saved is not None:
            old = entry[1]

            def work():
                learned = learn_from_edit(old, saved)
                GLib.idle_add(lambda: self.after_learn(row, learned) or False)
            threading.Thread(target=work, daemon=True).start()

    def after_learn(self, row, learned):
        if self.closing:
            return
        if learned and row in self.rows:
            row.highlight_words(learned)
        # A later edit's "Could not save" (and its Retry) outranks this news.
        if self.toast_kind == "failed":
            return
        self.show_toast("learned" if learned else "saved", learned)

    def unlearn(self, words, chip):
        chip.set_sensitive(False)

        def work():
            ok = unlearn_words(words)
            GLib.idle_add(lambda: (not self.closing and self.show_toast("unlearned", words, failed=not ok)) or False)
        threading.Thread(target=work, daemon=True).start()

    # ----- toasts (A4) -------------------------------------------------------------

    def show_toast(self, kind, words=(), failed=False):
        """Saved (1.8 s), Learned + Unlearn (3.5 s, paused while hovered),
        Could not save + Retry (6 s), Unlearned (1.8 s). In 200 ms, y +8."""
        self.dismiss_toast(animated=False)
        esc = GLib.markup_escape_text
        listed = ", ".join('<span weight="600" foreground="%s">%s</span>' % (INK, esc(w)) for w in words)
        box = Gtk.Box(spacing=8)
        box.get_style_context().add_class("toast")
        chip = None
        if kind in ("saved", "learned"):
            check = icon("object-select-symbolic", 12)
            check.get_style_context().add_class("ok")
            box.pack_start(check, False, False, 0)
            text = label("")
            text.set_markup("Saved" if kind == "saved" else "Learned: " + listed)
        elif kind == "failed" or failed:
            warn = icon("dialog-warning-symbolic", 12)
            warn.get_style_context().add_class("bad")
            box.pack_start(warn, False, False, 0)
            text = label("Could not save" if kind == "failed" else "Could not unlearn", "bad")
        else:
            text = label("")
            text.set_markup("Unlearned " + listed)
        text.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(text, False, False, 0)
        if kind == "learned":
            chip = Gtk.Button(label="Unlearn")
            chip.connect("clicked", lambda *_: self.unlearn(list(words), chip))
        elif kind == "failed":
            chip = Gtk.Button(label="Retry")
            chip.connect("clicked", lambda *_: self.finish_edit(True))
        if chip is not None:
            chip.set_can_focus(False)
            chip.get_style_context().add_class("chip")
            box.get_style_context().add_class("with-chip")
            box.pack_start(chip, False, False, 0)
        holder = Gtk.EventBox()
        holder.add(box)
        holder.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        if kind == "learned":
            holder.connect("enter-notify-event", lambda _w, e: e.detail != Gdk.NotifyType.INFERIOR
                           and self.toast_hovered(True))
            holder.connect("leave-notify-event", lambda _w, e: e.detail != Gdk.NotifyType.INFERIOR
                           and self.toast_hovered(False))
        self.toast_slot.pack_start(holder, False, False, 0)
        holder.show_all()
        self.toast, self.toast_kind = holder, kind
        rise = 0 if self.reduce else 8

        def step(e):
            holder.set_opacity(e)
            self.toast_slot.set_margin_bottom(int(32 + 12 - rise * (1 - e)))
        Tween(0.2, CURVE_OUT, step)
        self.hold_toast({"saved": 1.8, "unlearned": 1.8, "learned": 3.5, "failed": 6}[kind])

    def hold_toast(self, seconds):
        if self.toast_hold:
            GLib.source_remove(self.toast_hold)
        self.toast_remaining = seconds
        self.toast_deadline = time.monotonic() + seconds
        self.toast_hold = GLib.timeout_add(int(seconds * 1000), self.toast_expired)

    def toast_expired(self):
        self.toast_hold = None
        self.dismiss_toast()
        return False

    def toast_hovered(self, inside):
        """Learned holds while the pointer is on it, then runs out what was left."""
        if self.toast is None:
            return False
        if inside and self.toast_hold:
            GLib.source_remove(self.toast_hold)
            self.toast_hold = None
            self.toast_remaining = max(0, self.toast_deadline - time.monotonic())
        elif not inside and self.toast_hold is None:
            self.hold_toast(max(0.6, self.toast_remaining))
        return False

    def dismiss_toast(self, animated=True):
        """Out: 180 ms, curve in, fade."""
        if self.toast_hold:
            GLib.source_remove(self.toast_hold)
            self.toast_hold = None
        toast, self.toast, self.toast_kind = self.toast, None, None
        if toast is None:
            return
        if not animated:
            self.toast_slot.remove(toast)
            return
        alpha = toast.get_opacity()

        def done():
            if toast.get_parent() is self.toast_slot:
                self.toast_slot.remove(toast)
        Tween(0.18, CURVE_IN, lambda e: toast.set_opacity(alpha * (1 - e)), done)

    # ----- placement, focus, open and close -------------------------------------

    def monitor_area(self):
        display = Gdk.Display.get_default()
        monitor = None
        try:
            _screen, px, py = display.get_default_seat().get_pointer().get_position()[:3]
            monitor = display.get_monitor_at_point(px, py)
        except Exception:
            pass
        monitor = monitor or display.get_primary_monitor() or display.get_monitor(0)
        return monitor.get_workarea()

    def saved_size(self):
        try:
            with open(SIZE_FILE) as f:
                w, h = json.load(f)
            return int(w), int(h)
        except (OSError, ValueError, TypeError):
            return DEFAULT_SIZE

    def save_size(self):
        x, y, w, h = self.card_rect()
        try:
            os.makedirs(os.path.dirname(SIZE_FILE), exist_ok=True)
            with open(SIZE_FILE, "w") as f:
                json.dump([w, h], f)
        except OSError:
            pass

    def frame(self):
        """Centred, bottom edge on the pill's line, 12 inside the work area."""
        area = self.monitor_area()
        max_w, max_h = area.width - 2 * SCREEN_MARGIN, area.height - HEIGHT_RESERVE
        w, h = self.saved_size()
        w = max(MIN_SIZE[0], min(max_w, w))
        h = max(MIN_SIZE[1], min(max_h, h))
        x = area.x + (area.width - w) // 2
        y = area.y + area.height - BOTTOM_GAP - h
        x = max(area.x + SCREEN_MARGIN, min(area.x + area.width - SCREEN_MARGIN - w, x))
        y = max(area.y + SCREEN_MARGIN, min(area.y + area.height - SCREEN_MARGIN - h, y))
        geometry = Gdk.Geometry()
        geometry.min_width, geometry.min_height = MIN_SIZE[0] + 2 * self.margin, MIN_SIZE[1] + 2 * self.margin
        geometry.max_width, geometry.max_height = max_w + 2 * self.margin, max_h + 2 * self.margin
        self.set_geometry_hints(None, geometry, Gdk.WindowHints.MIN_SIZE | Gdk.WindowHints.MAX_SIZE)
        return x - self.margin, y - self.margin, w + 2 * self.margin, h + 2 * self.margin

    def server_time(self):
        window = self.get_window()
        if GdkX11 is not None and window is not None and isinstance(window, GdkX11.X11Window):
            try:
                return GdkX11.x11_get_server_time(window)
            except Exception:
                pass
        return Gtk.get_current_event_time()

    def take_keys(self):
        """Present with a fresh timestamp so the window manager lets it have
        the keys; once more through xdotool if it still has not."""
        if self.awaiting_focus or self.closing:
            return
        self.set_accept_focus(True)
        self.present_with_time(self.server_time())

        def check():
            if not self.is_active() and not self.closing and not self.awaiting_focus:
                window = self.get_window()
                if window is not None and hasattr(window, "get_xid") and shutil.which("xdotool"):
                    run(["xdotool", "windowactivate", str(window.get_xid())], timeout=1)
            return False
        GLib.timeout_add(250, check)

    def present_animated(self):
        """Open (A8): 220 ms after 40, curve out; rise 24 and fade in."""
        x, y, w, h = self.frame()
        rise = 0 if self.reduce else 24
        self.resize(w, h)
        self.move(x, y + rise)
        self.set_opacity(0)
        self.pipeline = pipeline_pid()
        if self.pipeline is not None:
            # Opened while a dictation runs (History chip on its pill): its
            # paste must reach the user's app, so no keys until it is done.
            self.hold_keys()
        else:
            self.set_accept_focus(True)
        self.show_all()
        if not self.awaiting_focus:
            self.take_keys()
        if self.motion:
            self.motion.stop()

        def step(e):
            self.set_opacity(e)
            self.move(x, int(y + rise * (1 - e)))
        self.motion = Tween(0.22, CURVE_OUT, step, delay=0.04)

    def hold_keys(self):
        log("dictation running: window shown without the keys")
        self.awaiting_focus = True
        self.set_accept_focus(False)

    def watch_pipeline(self):
        """Every 0.25 s: a dictation starting closes the window (unless an
        entry is being edited: dictating into the editor is fine); one
        finishing gives the keys to a window shown during it."""
        now = pipeline_pid()
        was, self.pipeline = self.pipeline, now
        if self.closing:
            return True
        if now is not None and now != was:
            log("dictation started")
            if self.editing is None:
                self.close_animated()
        elif now is None and was is not None:
            log("dictation finished, awaiting keys %s" % self.awaiting_focus)
            if self.awaiting_focus:
                self.awaiting_focus = False
                self.take_keys()
        return True

    def on_focus_in(self, *_):
        self.ever_focused = True
        return False

    def on_focus_out(self, *_):
        """A click elsewhere closes the window, except over an edit in progress."""
        if self.ever_focused and not self.closing and self.editing is None and not self.awaiting_focus \
                and not self.resizing:
            GLib.timeout_add(80, self.close_if_unfocused)
        return False

    def close_if_unfocused(self):
        if not self.is_active() and not self.closing and self.editing is None:
            self.close_animated(hand_back=False)
        return False

    def close_animated(self, hand_back=True):
        """Close (A8): 160 ms, curve in; fade out and drop 12, then quit.
        `hand_back`: give the keys back to the user's window (esc, ×, ↩, a
        new dictation); not after a click elsewhere, which chose its own."""
        if self.closing:
            return
        if self.editing:
            entry, field, _row = self.editing
            # Never close over unsaved changes; esc cancels the edit first.
            if field.text.strip() != entry[1]:
                self.error_bell()
                self.cancel_copy_close()
                return
            self.editing = None
        self.closing = True
        if self.motion:
            self.motion.stop()
        pos = self.get_position()
        alpha = self.get_opacity()
        drop = 0 if self.reduce else 12
        had_keys = self.is_active()

        def step(e):
            self.set_opacity(alpha * (1 - e))
            self.move(pos[0], int(pos[1] + drop * e))

        def done():
            self.hide()
            if hand_back and had_keys and self.return_window:
                run(["xdotool", "windowactivate", self.return_window["id"]], timeout=1)
            self.app.quit()
        self.motion = Tween(0.16, CURVE_IN, step, done)

    def error_bell(self):
        window = self.get_window()
        if window is not None:
            window.beep()

    def raise_again(self, target):
        """A second launch: Paste now goes where the user was, the list comes
        back to the newest, and the window takes the keys (unless a dictation
        runs)."""
        if self.pasting:
            return
        self.cancel_copy_close()
        if target is not None:
            self.return_window = target["window"]
            self.target = target["window"] if target["editable"] else None
        if self.editing:
            self.actions_stale = True
            self.update_footer()
        self.populate()
        if pipeline_pid() is not None and self.editing is None:
            self.pipeline = pipeline_pid()
            self.hold_keys()
        if self.closing and self.get_visible():
            self.closing = False
            self.present_animated()
        elif not self.closing:
            if self.awaiting_focus:
                self.show()
            else:
                self.take_keys()


class Probe:
    """Does the window the user was in have a focused field that takes
    typing? Asked through xhisper-learn (AT-SPI) before our window takes the
    focus, capped so the window never waits long."""

    def __init__(self, window):
        self.window = window
        self.proc = None
        self.result = None if window else False
        if window and window.get("pid"):
            try:
                self.proc = subprocess.Popen([sibling("xhisper-learn"), "editable", str(window["pid"])],
                                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL)
            except OSError:
                self.result = False
        elif window:
            self.result = False

    def poll(self):
        if self.result is None and self.proc is not None:
            rc = self.proc.poll()
            if rc is not None:
                self.result = rc == 0
        return self.result

    def give_up(self):
        if self.proc is not None and self.proc.poll() is None:
            self.proc.kill()
        self.result = False


PROBE_SECONDS = 1.0


class HistoryApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.abszar.xhisper.History")
        self.window = None
        self.probe = None
        self.waiting = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        try:
            os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
            with open(PID_FILE, "w") as f:
                f.write(str(os.getpid()))
        except OSError:
            pass
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)
        # Selectable labels would otherwise select all their text when focused.
        settings.set_property("gtk-label-select-on-focus", False)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.probe = Probe(LAUNCH_TARGET)

    def do_shutdown(self):
        try:
            with open(PID_FILE) as f:
                if f.read().strip() == str(os.getpid()):
                    os.unlink(PID_FILE)
        except OSError:
            pass
        Gtk.Application.do_shutdown(self)

    def do_activate(self):
        if self.waiting:
            return
        if self.window is not None:
            # Raised by a second launch: who has the focus now (not us)?
            target = active_window()
            own = self.window.get_window()
            if target is not None and own is not None and hasattr(own, "get_xid") \
                    and target["id"] == str(own.get_xid()):
                target = None
            if target is None:
                self.window.raise_again(None)
                return
            self.probe = Probe(target)
            self.await_probe(lambda ok: self.window.raise_again({"window": target, "editable": ok}))
            return
        self.await_probe(self.open_window)

    def await_probe(self, then):
        """Wait (at most PROBE_SECONDS) for the paste-target check, without
        blocking the main loop."""
        self.waiting = True
        self.hold()  # no window yet: the app must not end while it waits
        deadline = time.monotonic() + PROBE_SECONDS

        def check():
            result = self.probe.poll()
            if result is None and time.monotonic() < deadline:
                return True
            if result is None:
                log("paste target check took over %.1f s: no Paste" % PROBE_SECONDS)
                self.probe.give_up()
            self.waiting = False
            then(bool(self.probe.result))
            self.release()
            return False
        if check():
            GLib.timeout_add(20, check)

    def open_window(self, editable):
        self.window = HistoryWindow(self)
        self.window.return_window = LAUNCH_TARGET
        if LAUNCH_TARGET is not None and editable:
            self.window.target = LAUNCH_TARGET
            self.window.populate()
        log("open: paste target %s, return window %s"
            % (LAUNCH_TARGET["class"] if (LAUNCH_TARGET and editable) else "none",
               LAUNCH_TARGET["class"] if LAUNCH_TARGET else "none"))
        self.window.present_animated()


if __name__ == "__main__":
    sys.exit(HistoryApp().run(sys.argv))
