def label(text, *classes, xalign=0.0):
    w = Gtk.Label(label=text, xalign=xalign)
    for c in classes:
        w.get_style_context().add_class(c)
    return w


def icon(name, size):
    image = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
    image.set_pixel_size(size)
    return image


def bars_widget(heights, width, gap, radius, rgba, box_height):
    """Rounded bars like the pill's: the header mark and the empty state."""
    area = Gtk.DrawingArea()
    area.set_size_request(int(round(len(heights) * width + (len(heights) - 1) * gap)), box_height)
    area.set_valign(Gtk.Align.CENTER)

    def draw(_w, cr):
        cr.set_source_rgba(*rgba)
        for i, h in enumerate(heights):
            x, y = i * (width + gap), (box_height - h) / 2
            r = min(radius, width / 2, h / 2)
            cr.new_sub_path()
            cr.arc(x + r, y + r, r, 3.14159265, 4.71238898)
            cr.arc(x + width - r, y + r, r, -1.5707963, 0)
            cr.arc(x + width - r, y + h - r, r, 0, 1.5707963)
            cr.arc(x + r, y + h - r, r, 1.5707963, 3.14159265)
            cr.close_path()
        cr.fill()
        return False
    area.connect("draw", draw)
    return area


def ink_rgba(alpha):
    return (237 / 255, 232 / 255, 217 / 255, alpha)


class RowButton(Gtk.Button):
    """A row action (A9 §5, §6): the 28 px icon button (Edit, Copy), the
    primary capsule (Paste, or Copy without a paste target; Save) and the
    ghost capsule (Cancel). Copy turns into "✓ Copied" for a moment."""

    def __init__(self, kind, text=None, icon_name=None, tooltip=None):
        super().__init__()
        self.kind = kind
        self.set_can_focus(False)
        self.set_relief(Gtk.ReliefStyle.NONE)
        self.get_style_context().add_class(kind)
        if tooltip:
            self.set_tooltip_text(tooltip)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=160, interpolate_size=True, hhomogeneous=False)
        self.rest = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        if icon_name:
            self.rest.pack_start(icon(icon_name, 14), False, False, 0)
            self.set_size_request(28, 28)
        else:
            self.rest.set_margin_start(12)
            self.rest.set_margin_end(12)
            self.rest.pack_start(label(text), False, False, 0)
        self.glyph = label("↩", "glyph")
        self.glyph.set_no_show_all(True)
        self.rest.pack_start(self.glyph, False, False, 0)
        copied = Gtk.Box(spacing=5)
        copied.set_margin_start(9 if icon_name else 10)
        copied.set_margin_end(11 if icon_name else 12)
        copied.pack_start(icon("object-select-symbolic", 12), False, False, 0)
        copied.pack_start(label("Copied"), False, False, 0)
        self.stack.add_named(self.rest, "rest")
        self.stack.add_named(copied, "copied")
        self.add(self.stack)
        self.inert = False

    def set_return_glyph(self, on):
        if self.kind == "icon":
            return
        self.glyph.set_visible(on)

    def show_copied(self, shown=None):
        """160 ms widen + crossfade into the check and "Copied", hold 1200,
        200 ms back. Not clickable meanwhile."""
        if self.inert:
            if shown:
                shown()
            return
        self.inert = True
        if self.kind == "icon":
            self.get_style_context().add_class("copied")
        self.stack.set_transition_duration(160)
        self.stack.set_visible_child_name("copied")

        def back():
            self.stack.set_transition_duration(200)
            self.stack.set_visible_child_name("rest")
            self.get_style_context().remove_class("copied")
            GLib.timeout_add(200, lambda: setattr(self, "inert", False) or False)
            return False
        GLib.timeout_add(160, lambda: (shown() if shown else None) or False)
        GLib.timeout_add(160 + 1200, back)


class Row(Gtk.EventBox):
    """One history entry (A9 §4, A5): radius 11, padding T6 R12 B12 L12; a
    28 px meta line (time left, actions right), the text 2 below, "Show
    more" below the text when it is clamped."""

    def __init__(self, entry, index, controller):
        super().__init__()
        self.entry, self.index, self.c = entry, index, controller
        self.set_visible_window(False)
        self.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("enter-notify-event", self.on_enter)
        self.connect("leave-notify-event", self.on_leave)
        self.hovered = self.is_target = self.expanded = self.editing = self.dimmed = False
        self.lines = 1
        self.measured_width = 0
        self.highlight = None  # (words, alpha) while the learned words are lit
        self.actions_alpha = 0.0
        self.actions_tween = None
        self.actions_shown = False

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.box.get_style_context().add_class("row")
        self.add(self.box)
        meta = Gtk.Box(spacing=4)
        meta.set_size_request(-1, 28)
        self.time = label("", "time")
        self.time.set_ellipsize(Pango.EllipsizeMode.END)
        self.time.set_valign(Gtk.Align.CENTER)
        meta.pack_start(self.time, True, True, 0)
        self.actions = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        self.actions.set_opacity(0)
        meta.pack_end(self.actions, False, False, 0)
        self.box.pack_start(meta, False, False, 0)

        self.text = Gtk.Label(xalign=0, wrap=True, selectable=True)
        self.text.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.text.set_ellipsize(Pango.EllipsizeMode.END)
        self.text.get_style_context().add_class("entry")
        self.text.set_margin_top(2)
        self.text.set_can_focus(False)
        self.text.connect("size-allocate", self.on_text_allocate)
        # RTL (A9): the whole entry reads right to left. Measured: the label's
        # xalign 1 right-aligns every wrapped line; flipping the widget's own
        # direction as well flips Pango's alignment back to the left.
        if is_rtl(entry[1]):
            self.text.set_xalign(1.0)
        self.box.pack_start(self.text, False, False, 0)

        self.more = Gtk.Button()
        self.more.set_can_focus(False)
        self.more.set_relief(Gtk.ReliefStyle.NONE)
        self.more.get_style_context().add_class("more")
        self.more.set_halign(Gtk.Align.START)
        more_box = Gtk.Box(spacing=3)
        self.more_label = label("Show more")
        self.more_icon = icon("pan-down-symbolic", 10)
        more_box.pack_start(self.more_label, False, False, 0)
        more_box.pack_start(self.more_icon, False, False, 0)
        self.more.add(more_box)
        self.more.connect("clicked", lambda *_: self.set_expanded(not self.expanded))
        more_box.show_all()
        self.more.set_no_show_all(True)
        self.box.pack_start(self.more, False, False, 0)
        self.watch_crossings(self.more)
        self.watch_crossings(self.text)
        self.field = None
        self.refresh_time()
        self.render_text()
        self.show_all()

    # The buttons, the selectable text and Show more have input windows of
    # their own: going onto one sends the row a "leave" (and the actions faded
    # out under the pointer, 2026-10-18). So every crossing just asks where
    # the pointer really is.
    def on_enter(self, *_):
        GLib.idle_add(self.recheck_hover)

    def on_leave(self, *_):
        GLib.idle_add(self.recheck_hover)

    def watch_crossings(self, widget):
        widget.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        widget.connect("enter-notify-event", self.on_enter)
        widget.connect("leave-notify-event", self.on_leave)

    def pointer_inside(self):
        window = self.get_window()  # the parent's window: the allocation is in it
        if window is None or not self.get_mapped():
            return False
        pointer = Gdk.Display.get_default().get_default_seat().get_pointer()
        _win, x, y, _mask = window.get_device_position(pointer)
        a = self.get_allocation()
        return a.x <= x < a.x + a.width and a.y <= y < a.y + a.height

    def recheck_hover(self):
        inside = self.pointer_inside()
        if inside != self.hovered:
            self.hovered = inside
            self.refresh(True)
        return False

    def set_actions(self, buttons):
        for child in self.actions.get_children():
            self.actions.remove(child)
        for b in buttons:
            self.actions.pack_start(b, False, False, 0)
            if not getattr(b, "crossings_watched", False):
                b.crossings_watched = True
                self.watch_crossings(b)
        self.actions.show_all()

    def refresh_time(self):
        """"2 min ago", or "2 min ago · Editing" while the editor is open."""
        self.time.set_text(describe_time(self.entry[0]) + (" · Editing" if self.editing else ""))

    def refresh(self, animated):
        """Fill and actions: shown on hover, the Enter target and the row being edited."""
        hover = self.hovered and self.c.editing is None and not self.dimmed
        ctx = self.box.get_style_context()
        for cls, on in (("hover", hover and not self.editing), ("target", self.is_target),
                        ("editing", self.editing)):
            if on:
                ctx.add_class(cls)
            else:
                ctx.remove_class(cls)
        if self.primary is not None:
            self.primary.set_return_glyph(self.is_target and not self.editing)
        show = self.is_target or self.editing or hover
        if show == self.actions_shown:
            return
        self.actions_shown = show
        if self.actions_tween:
            self.actions_tween.stop()
        start, end = self.actions_alpha, 1.0 if show else 0.0
        if not animated:
            self.set_actions_alpha(end)
            return

        def step(e):
            self.set_actions_alpha(start + (end - start) * e)
        self.actions_tween = Tween(0.12 if show else 0.08, CURVE_OUT if show else CURVE_IN, step)

    primary = None
    copy_button = None

    def set_actions_alpha(self, a):
        self.actions_alpha = a
        self.actions.set_opacity(a)

    def set_target(self, on):
        self.is_target = on
        self.refresh(True)
        self.apply_clamp()

    def set_expanded(self, on):
        self.expanded = on
        self.apply_clamp()

    def markup(self):
        esc = GLib.markup_escape_text
        words, alpha = self.highlight or ([], 0)
        pattern = None
        if words and alpha > 0:
            pattern = re.compile(r"(?<!\w)(%s)(?!\w)" % "|".join(re.escape(w) for w in words))
        parts = []
        for bullet, line in display_lines(self.entry[1]):
            text = esc(line)
            if pattern:
                text = "".join(
                    '<span background="#EDE8D9" bgalpha="%d%%">%s</span>' % (max(1, int(alpha * 16)), esc(p))
                    if i % 2 else esc(p) for i, p in enumerate(pattern.split(line)))
            if bullet:
                text = '<span foreground="#CCC7BA" alpha="62%%">%s</span> %s' % (esc(bullet), text)
            parts.append(text)
        return "\n".join(parts)

    def render_text(self):
        self.text.set_markup(self.markup())
        self.measured_width = 0  # re-measure

    def on_text_allocate(self, _w, alloc):
        if alloc.width != self.measured_width and alloc.width > 1:
            self.measured_width = alloc.width
            layout = self.text.create_pango_layout(None)
            layout.set_markup(self.markup(), -1)
            layout.set_width(alloc.width * Pango.SCALE)
            layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            lines = layout.get_line_count()
            if lines != self.lines:
                self.lines = lines
                GLib.idle_add(lambda: self.apply_clamp() or False)

    def apply_clamp(self):
        """3 lines (6 on the Enter target) with "Show more"; expanded shows all."""
        if self.editing:
            return
        clamp = 6 if self.is_target else 3
        truncatable = self.lines > clamp
        self.text.set_lines(-1 if (self.expanded and truncatable) else clamp)
        self.text.set_ellipsize(Pango.EllipsizeMode.NONE if (self.expanded and truncatable)
                                else Pango.EllipsizeMode.END)
        self.more_label.set_text("Show less" if self.expanded else "Show more")
        self.more_icon.set_from_icon_name("pan-up-symbolic" if self.expanded else "pan-down-symbolic",
                                          Gtk.IconSize.MENU)
        self.more.set_visible(truncatable)

    def set_dimmed(self, on):
        """Another row is edited (A5): whole row at 40 %, no hover, no clicks."""
        if on == self.dimmed:
            return
        self.dimmed = on
        self.set_above_child(on)  # the event box swallows every click
        start = self.get_opacity()
        end = 0.4 if on else 1.0
        Tween(0.18 if on else 0.15, CURVE_STD, lambda e: self.set_opacity(start + (end - start) * e))
        self.refresh(True)

    def enter_edit(self, field, buttons):
        self.editing = True
        self.field = field
        self.refresh_time()
        self.rest_actions = self.actions.get_children()
        self.set_actions(buttons)
        self.text.hide()
        self.more.hide()
        field.set_margin_top(2)
        self.box.pack_start(field, False, False, 0)
        field.show_all()
        self.refresh(True)

    def leave_edit(self, saved_text=None):
        if not self.editing:
            return
        if saved_text is not None:
            self.entry = (self.entry[0], saved_text)
        self.editing = False
        if self.field is not None:
            self.box.remove(self.field)
            self.field = None
        self.set_actions(self.rest_actions)
        self.refresh_time()
        self.text.show()
        self.render_text()
        self.lines = 1
        self.apply_clamp()
        self.refresh(True)

    def flash(self):
        """A7 new entry: an ink 0.10 fill that fades out over 900 ms."""
        ctx = self.box.get_style_context()
        ctx.add_class("flash")

        def fade():
            ctx.remove_class("flash")
            ctx.add_class("flash-out")
            GLib.timeout_add(950, lambda: ctx.remove_class("flash-out") or False)
            return False
        GLib.timeout_add(60, fade)

    def highlight_words(self, words):
        """A4: the learned words lit for 1500 ms, then faded out over 600 ms."""
        self.highlight = (words, 1.0)
        self.render_text()

        def fade(e):
            self.highlight = (words, 1 - e) if e < 1 else None
            self.render_text()
        Tween(0.6, CURVE_STD, fade, delay=1.5)


class EditField(Gtk.Box):
