# ----- The history file (macos/HistoryStore.swift) ---------------------------

def load_entries(path=HISTORY_FILE):
    """Newest first, as (time, text) tuples."""
    entries = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                if isinstance(item, dict) and isinstance(item.get("text"), str) and item["text"]:
                    entries.append((str(item.get("time") or ""), item["text"]))
    except OSError:
        pass
    return list(reversed(entries))


def describe_time(stamp, now=None):
    """"Just now" under 1 min, "N min ago" under 60 min, "N h ago" under 6 h,
    then "Today 09:12", "Yesterday 14:03", "Mon 17:20" under 7 days, else
    "12 Oct 09:30". 24 h clock. Future stamps read "Just now"."""
    try:
        when = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%S%z").astimezone()
    except (TypeError, ValueError):
        return stamp or ""
    now = now or datetime.now().astimezone()
    age = (now - when).total_seconds()
    if age < 60:
        return "Just now"
    if age < 3600:
        return "%d min ago" % int(age // 60)
    if age < 6 * 3600:
        return "%d h ago" % int(age // 3600)
    clock = when.strftime("%H:%M")
    if when.date() == now.date():
        return "Today " + clock
    if when.date() == now.date() - timedelta(days=1):
        return "Yesterday " + clock
    days = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
    months = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
    if age < 7 * 86400:
        return "%s %s" % (days[when.weekday()], clock)
    return "%02d %s %s" % (when.day, months[when.month - 1], clock)


def display_lines(text):
    """(bullet, text) per line: "- ", "* ", "• " become "•", "N. " keeps its
    number. Display only: Copy and Paste use the raw stored text."""
    out = []
    for line in text.split("\n"):
        for marker in ("- ", "* ", "• "):
            if line.startswith(marker):
                out.append(("•", line[len(marker):]))
                break
        else:
            m = re.match(r"([0-9]+)\. ", line)
            out.append((m.group(1) + ".", line[m.end():]) if m else (None, line))
    return out


RTL_RANGES = ((0x0590, 0x08FF), (0xFB1D, 0xFDFF), (0xFE70, 0xFEFF), (0x10800, 0x10FFF), (0x1E800, 0x1EFFF))


def is_rtl(text):
    """Right to left when the first strong (alphabetic) character is, like
    CSS dir="auto"."""
    for ch in text:
        if ch.isalpha():
            code = ord(ch)
            return any(lo <= code <= hi for lo, hi in RTL_RANGES)
    return False


def encode_entry(stamp, text):
    """Same shape as xhisper.sh's `jq -c` line: {"time":...,"text":...}."""
    return json.dumps({"time": stamp, "text": text}, ensure_ascii=False, separators=(",", ":"))


def update_history(entry, new_text, path=HISTORY_FILE, attempts=3):
    """Replace one entry's text in place (matched on time and old text):
    temp file created 0600, then renamed over the history. False on failure."""
    try:
        with open(path, encoding="utf-8") as f:
            original = f.read()
    except OSError:
        return False
    lines = original.split("\n")
    for i in range(len(lines) - 1, -1, -1):
        try:
            item = json.loads(lines[i])
        except ValueError:
            continue
        if isinstance(item, dict) and (str(item.get("time") or ""), item.get("text")) == entry:
            lines[i] = encode_entry(entry[0], new_text)
            break
    else:
        return False
    # Not xhisper.sh's "$HISTORY_FILE.tmp": both may write at once.
    tmp = "%s.edit.%d" % (path, os.getpid())
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        os.chmod(tmp, 0o600)
        # A dictation may have been appended meanwhile (the window stays open
        # while one runs): start over rather than drop it.
        with open(path, encoding="utf-8") as f:
            if f.read() != original:
                os.unlink(tmp)
                return update_history(entry, new_text, path, attempts - 1) if attempts > 1 else False
        os.replace(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def arrival(shown, file):
    """What a change of the history file does to the shown list: ("same",),
    ("insert", count, keep) for new dictations on top (the oldest trimmed
    off the end), or ("rebuild",) for anything else."""
    if shown == file:
        return ("same",)
    if not shown or not file:
        return ("rebuild",)
    for k in range(len(file)):
        keep = len(file) - k
        if keep > len(shown):
            continue
        if file[k:] == shown[:keep] and not any(e in shown for e in file[:k]):
            return ("insert", k, keep)
    return ("rebuild",)


def history_size():
    try:
        with open(os.path.join(CONFIG_DIR, "xhisperrc"), encoding="utf-8") as f:
            for line in f:
                name, sep, value = line.partition(":")
                if sep and name.strip() == "history-size":
                    return int(value.split(" #", 1)[0].strip().strip("'\""))
    except (OSError, ValueError):
        pass
    return 20


