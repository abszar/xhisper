#!/usr/bin/env python3
"""xhisper-notify: Animated wave pill overlay for xhisper status."""

import math
import sys
import os
import signal
import subprocess
import time

# GTK is optional: without PyGObject we degrade to desktop notifications
# instead of crashing and leaving the user with no feedback at all.
HAS_GTK = True
try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    import cairo
except (ImportError, ValueError):
    HAS_GTK = False

# Detect Wayland and try gtk-layer-shell for overlay positioning
IS_WAYLAND = os.environ.get('XDG_SESSION_TYPE') == 'wayland'
HAS_LAYER_SHELL = False
if IS_WAYLAND and HAS_GTK:
    try:
        gi.require_version('GtkLayerShell', '0.1')
        from gi.repository import GtkLayerShell
        HAS_LAYER_SHELL = True
    except (ValueError, ImportError):
        pass

# Wave bar layout — heights (0–1) matching an audio waveform shape
NUM_BARS = 17
BAR_WIDTH = 5
BAR_GAP = 4
BAR_RADIUS = 2.5
BASE_HEIGHTS = [
    0.30, 0.85, 0.30, 0.90, 0.55, 0.80, 0.95, 0.35,
    0.60, 0.95, 0.80, 0.25, 0.85, 0.90, 0.55, 0.30, 0.50,
]

# Colors
BG_COLOR = (0.10, 0.10, 0.10, 0.93)
BAR_COLOR = (0.93, 0.91, 0.85)
ERROR_BAR_COLOR = (0.91, 0.45, 0.40)
TEXT_COLOR = (0.80, 0.78, 0.73, 0.9)

STATE_LABELS = {
    "recording": "Recording",
    "transcribing": "Transcribing",
    "editing": "Editing",
    "done": "Done",
    "silent": "No sound",
    "error": "Failed",
    "cancelled": "Cancelled",
}

# States whose pill carries a clickable "History" chip. On "recording" a click
# also cancels the dictation (via XHISPER_HISTORYFLAG, polled by xhisper.sh).
HISTORY_STATES = ("recording", "silent")
CHIP_LABEL = "History"
CHIP_COLOR = (1.0, 1.0, 1.0, 0.10)
CHIP_HOVER_COLOR = (1.0, 1.0, 1.0, 0.22)
LAUNCH_SECONDS = 0.28  # pill-to-window transition

RUNTIME_DIR = os.environ.get("XHISPER_RUNTIME_DIR") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "xhisper")
try:
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
except OSError:
    RUNTIME_DIR = "/tmp"
PID_FILE = os.path.join(RUNTIME_DIR, "xhisper-notify.pid")
HISTORY_FILE = os.environ.get("XHISPER_HISTORY_FILE") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "xhisper", "history.jsonl")


def has_history():
    try:
        return os.path.getsize(HISTORY_FILE) > 0
    except OSError:
        return False


def history_command():
    """The history window next to us (--local checkout) or the installed one."""
    sibling = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "xhisper-history")
    return sibling if os.access(sibling, os.X_OK) else "xhisper-history"


# Base class is object when GTK is missing, so the module still imports and
# main() can fall back to notify-send.
class WavePill(Gtk.Window if HAS_GTK else object):
    def __init__(self, state="recording", timeout_ms=0):
        wtype = Gtk.WindowType.TOPLEVEL if (IS_WAYLAND and HAS_LAYER_SHELL) else Gtk.WindowType.POPUP
        super().__init__(type=wtype)
        self.state = state
        self.label = STATE_LABELS.get(state, state)
        self.start_time = time.time()
        self.fade_alpha = 0.0
        self.slide_progress = 0.0
        self.closing = False
        self.use_layer_shell = IS_WAYLAND and HAS_LAYER_SHELL
        self.show_chip = state in HISTORY_STATES and has_history()
        self.chip_hover = False
        self.pointer_inside = False
        self.launch_start = None  # set when the History chip is clicked

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_decorated(False)

        # Dimensions
        wave_w = NUM_BARS * BAR_WIDTH + (NUM_BARS - 1) * BAR_GAP
        self.pill_height = 48
        self.max_bar_height = self.pill_height - 14
        text_w = (len(self.label) + 3) * 8 + 8
        self.pill_width = 24 + wave_w + 16 + text_w + 20
        self.wave_x = 20
        if self.show_chip:
            self.chip_w, self.chip_h = 72, 28
            self.chip_x = self.pill_width - 8
            self.chip_y = (self.pill_height - self.chip_h) / 2
            self.pill_width += self.chip_w + 2
        self.set_size_request(self.pill_width, self.pill_height + 4)

        if self.use_layer_shell:
            # Wayland: use layer-shell to anchor at bottom-center
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
            GtkLayerShell.set_exclusive_zone(self, -1)
            self.hidden_margin = -(self.pill_height + 10)
            self.visible_margin = 55
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, self.hidden_margin)
        else:
            # X11: position at bottom-center, slide up from below
            display = Gdk.Display.get_default()
            monitor = display.get_primary_monitor() or display.get_monitor(0)
            geom = monitor.get_geometry()
            self.target_x = geom.x + (geom.width - self.pill_width) // 2
            self.screen_bottom = geom.y + geom.height
            self.target_y = self.screen_bottom - self.pill_height - 55
            self.slide_distance = 60
            self.move(self.target_x, self.screen_bottom)

        self.connect('draw', self.on_draw)
        if self.show_chip:
            self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                            | Gdk.EventMask.POINTER_MOTION_MASK
                            | Gdk.EventMask.ENTER_NOTIFY_MASK
                            | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            self.connect('button-press-event', self.on_click)
            self.connect('motion-notify-event', self.on_motion)
            self.connect('enter-notify-event', self.on_enter)
            self.connect('leave-notify-event', self.on_leave)
        GLib.timeout_add(16 if self.show_chip else 33, self.on_tick)

        if timeout_ms > 0:
            GLib.timeout_add(max(timeout_ms - 500, 100), self.start_close)

        # Last line of defence: recording/transcribing/editing carry no timeout,
        # so a pill whose registration went missing used to stay on screen until
        # the next reboot. Nothing may outlive the pipeline that spawned it.
        max_life = overlay_max_seconds()
        if max_life > 0:
            GLib.timeout_add_seconds(max_life, lambda: Gtk.main_quit() or False)

        self.show_all()

    def start_close(self):
        if self.launch_start is not None:
            return False
        # Never slide away from under the pointer: the user may be reaching
        # for the History chip.
        if self.pointer_inside:
            GLib.timeout_add(400, self.start_close)
            return False
        self.closing = True
        GLib.timeout_add(600, lambda: Gtk.main_quit() or False)
        return False

    def in_chip(self, x, y):
        return (self.chip_x <= x <= self.chip_x + self.chip_w
                and self.chip_y <= y <= self.chip_y + self.chip_h)

    def on_enter(self, _widget, _event):
        self.pointer_inside = True

    def on_leave(self, _widget, _event):
        self.pointer_inside = False
        self.set_chip_hover(False)

    def on_motion(self, _widget, event):
        self.set_chip_hover(self.in_chip(event.x, event.y))

    def set_chip_hover(self, hover):
        if hover == self.chip_hover:
            return
        self.chip_hover = hover
        window = self.get_window()
        if window:
            cursor = Gdk.Cursor.new_from_name(self.get_display(), "pointer") if hover else None
            window.set_cursor(cursor)

    def on_click(self, _widget, event):
        if event.button != 1 or not self.in_chip(event.x, event.y) or self.launch_start is not None:
            return False
        if self.state == "recording":
            # Stop listening: xhisper.sh sees the flag, drops the recording,
            # plays the cancel sound and leaves this pill to finish its exit.
            flag = os.environ.get("XHISPER_HISTORYFLAG")
            if flag:
                try:
                    open(flag, "w").close()
                except OSError:
                    pass
        try:
            subprocess.Popen([history_command()], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass
        self.launch_start = time.time()
        GLib.timeout_add(int(LAUNCH_SECONDS * 1000) + 40, lambda: Gtk.main_quit() or False)
        return True

    def ease_out_cubic(self, t):
        return 1.0 - (1.0 - t) ** 3

    def on_tick(self):
        if self.launch_start is not None:
            # Transition to the history window: the pill lifts toward where the
            # window opens and fades out while the window fades in.
            p = min(1.0, (time.time() - self.launch_start) / LAUNCH_SECONDS)
            lift = 40 * self.ease_out_cubic(p)
            self.fade_alpha = 1.0 - p
            if self.use_layer_shell:
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, int(self.visible_margin + lift))
            else:
                self.move(self.target_x, int(self.target_y - lift))
            self.queue_draw()
            return True
        if not self.closing:
            self.fade_alpha = min(1.0, self.fade_alpha + 0.12)
            self.slide_progress = min(1.0, self.slide_progress + 0.08)
        else:
            self.fade_alpha = max(0.0, self.fade_alpha - 0.05)
            self.slide_progress = max(0.0, self.slide_progress - 0.06)

        eased = self.ease_out_cubic(self.slide_progress)

        if self.use_layer_shell:
            margin = int(self.hidden_margin + (self.visible_margin - self.hidden_margin) * eased)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, margin)
        else:
            y = self.target_y + self.slide_distance * (1.0 - eased)
            self.move(self.target_x, int(y))

        self.queue_draw()
        return True

    def rounded_rect(self, cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_path()
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.close_path()

    def bar_height(self, i, t):
        base = BASE_HEIGHTS[i] * self.max_bar_height
        if self.state == "recording":
            f = 0.7 + 0.3 * math.sin(t * 5 + i * 0.45)
        elif self.state in ("transcribing", "editing"):
            f = 0.75 + 0.15 * math.sin(t * 2.5 + i * 0.35)
        elif self.state == "done":
            f = max(0.15, 1.0 - t * 1.5)
        elif self.state in ("silent", "error", "cancelled"):
            f = 0.2 + 0.05 * math.sin(t * 1.5 + i * 0.3)
        else:
            f = 0.5
        return max(base * f, BAR_WIDTH)

    def on_draw(self, widget, cr):
        t = time.time() - self.start_time
        a = self.fade_alpha
        h = self.pill_height
        w = self.pill_width
        r = h / 2
        cy = h / 2

        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        self.rounded_rect(cr, 2, 3, w, h, r)
        cr.set_source_rgba(0, 0, 0, 0.3 * a)
        cr.fill()

        self.rounded_rect(cr, 0, 0, w, h, r)
        cr.set_source_rgba(BG_COLOR[0], BG_COLOR[1], BG_COLOR[2], BG_COLOR[3] * a)
        cr.fill()

        bar_color = ERROR_BAR_COLOR if self.state == "error" else BAR_COLOR
        for i in range(NUM_BARS):
            bx = self.wave_x + i * (BAR_WIDTH + BAR_GAP)
            bh = self.bar_height(i, t)
            by = cy - bh / 2
            self.rounded_rect(cr, bx, by, BAR_WIDTH, bh, BAR_RADIUS)
            cr.set_source_rgba(bar_color[0], bar_color[1], bar_color[2], a)
            cr.fill()

        dots = ""
        if self.state in ("recording", "transcribing", "editing"):
            dots = "." * (int(t * 2) % 4)
        tx = self.wave_x + NUM_BARS * (BAR_WIDTH + BAR_GAP) + 8
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(13)
        ext = cr.text_extents(self.label + dots)
        cr.move_to(tx, cy + ext.height / 2)
        cr.set_source_rgba(TEXT_COLOR[0], TEXT_COLOR[1], TEXT_COLOR[2], TEXT_COLOR[3] * a)
        cr.show_text(self.label + dots)

        if self.show_chip:
            launching = self.launch_start is not None
            color = CHIP_HOVER_COLOR if (self.chip_hover or launching) else CHIP_COLOR
            self.rounded_rect(cr, self.chip_x, self.chip_y, self.chip_w, self.chip_h, self.chip_h / 2)
            cr.set_source_rgba(color[0], color[1], color[2], color[3] * a)
            cr.fill()
            cr.set_font_size(12)
            ext = cr.text_extents(CHIP_LABEL)
            cr.move_to(self.chip_x + (self.chip_w - ext.width) / 2 - ext.x_bearing,
                       cy + ext.height / 2)
            cr.set_source_rgba(BAR_COLOR[0], BAR_COLOR[1], BAR_COLOR[2], a)
            cr.show_text(CHIP_LABEL)

        return False


def overlay_max_seconds():
    """Hard lifetime cap, in seconds. xhisper.sh passes the value past which it
    considers its own pipeline wedged; 0 disables the cap."""
    try:
        return max(0, int(os.environ.get("XHISPER_OVERLAY_MAX_SECONDS", "900")))
    except ValueError:
        return 900


def read_pid_file():
    try:
        with open(PID_FILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def write_pid_file():
    try:
        with open(PID_FILE, 'w') as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def is_alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def release_pid_file():
    """Drop our registration — but only if it is still ours.

    This used to be an unconditional unlink, which is what left pills stuck on
    screen: an overlay that took longer to shut down than its successor took to
    start would delete the successor's registration, and the next overlay's
    kill_existing() then found nothing to kill.
    """
    if read_pid_file() == os.getpid():
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass


def start_time(pid):
    """Process start time in clock ticks, or None. Field 22 of /proc/pid/stat;
    read past the last ')' because the comm field may contain spaces."""
    try:
        with open('/proc/%d/stat' % pid) as f:
            stat = f.read()
        return int(stat[stat.rindex(')') + 2:].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def is_older(pid, my_start, my_pid):
    """True if pid was started before us. Overlays only ever supersede their
    predecessors — killing a newer one would take down the pill that is meant
    to replace ours."""
    other = start_time(pid)
    if other is None or my_start is None:
        return pid < my_pid
    if other != my_start:
        return other < my_start
    return pid < my_pid


def is_overlay_argv(argv):
    """True if argv is this program running, not something that names it.

    The shebang turns us into `python3 /path/xhisper-notify <state>`, so the
    program is argv[0] (direct exec) or argv[1] behind a python interpreter.
    Matching the basename anywhere in argv also hit `vim xhisper-notify`,
    `less`, `git diff -- xhisper-notify` or a shell script handed the path, and
    killed them on the next dictation.
    """
    if not argv:
        return False
    prog = os.path.basename(argv[0])
    if prog == 'xhisper-notify':
        return True
    return (len(argv) > 1 and prog.startswith('python')
            and os.path.basename(argv[1]) == 'xhisper-notify')


def running_overlays():
    """Every live overlay process older than us, whether or not it is registered.

    The PID file is a single slot and can be lost; scanning /proc cannot. Only
    processes that are actually running this program are targets.
    """
    found = []
    if not os.path.isdir('/proc'):
        return found
    me = os.getpid()
    my_start = start_time(me)
    uid = os.getuid()
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            if os.stat('/proc/%d' % pid).st_uid != uid:
                continue
            with open('/proc/%d/cmdline' % pid, 'rb') as f:
                argv = f.read().decode('utf-8', 'replace').split('\0')
        except OSError:
            continue
        if is_overlay_argv(argv):
            if is_older(pid, my_start, me):
                found.append(pid)
    return found


def kill_existing():
    me = os.getpid()
    targets = set(running_overlays())
    recorded = read_pid_file()
    if recorded is not None and recorded != me and is_older(recorded, start_time(me), me):
        targets.add(recorded)

    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    # Wait for them to actually go instead of guessing at a sleep, then insist.
    deadline = time.time() + 0.5
    while targets and time.time() < deadline:
        targets = {pid for pid in targets if is_alive(pid)}
        if targets:
            time.sleep(0.02)
    for pid in targets:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass

    # Clear the slot only when it points at something that is gone, so we never
    # discard a live overlay's registration.
    recorded = read_pid_file()
    if recorded is not None and not is_alive(recorded):
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass


def main():
    if len(sys.argv) < 2:
        print("Usage: xhisper-notify <state> [--timeout MS]", file=sys.stderr)
        print("States: recording, transcribing, editing, done, silent, error, cancelled, hide", file=sys.stderr)
        sys.exit(1)

    state = sys.argv[1]
    timeout_ms = 0
    if "--timeout" in sys.argv:
        idx = sys.argv.index("--timeout")
        if idx + 1 < len(sys.argv):
            try:
                timeout_ms = int(sys.argv[idx + 1])
            except ValueError:
                timeout_ms = 0

    kill_existing()
    if state == "hide":
        return

    # No GTK, or Wayland without layer-shell: fall back to notify-send
    if not HAS_GTK or (IS_WAYLAND and not HAS_LAYER_SHELL):
        label = STATE_LABELS.get(state, state)
        t = str(timeout_ms) if timeout_ms > 0 else "30000"
        try:
            subprocess.Popen(['notify-send', '-a', 'xhisper', 'xhisper', label, '-t', t])
        except OSError:
            pass
        return

    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(Gtk.main_quit))

    # Register before building the window: GTK setup costs about half a second,
    # and until the PID file names us the next overlay cannot find us to kill.
    write_pid_file()

    WavePill(state=state, timeout_ms=timeout_ms)
    Gtk.main()

    release_pid_file()


if __name__ == "__main__":
    main()
