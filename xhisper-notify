# Geometry (design B1 / B2): every dictation state is 310 x 38, so the pill
# never resizes; the learned notice hugs its text.
WIDTH = 310
HEIGHT = 38
PAD_LEFT = 16
PAD_RIGHT = 7         # = chip inset: chip radius 12 = 19 - 7, concentric
NUM_BARS = 17
BAR_WIDTH = 4
BAR_GAP = 3
BAR_RADIUS = 2
MIN_BAR = 4
MAX_BAR = 24
LABEL_GAP = 12        # bars to label
LABEL_SLOT = 88       # fixed slot: no text ever moves the chip
DOT_WIDTH = 4
CHIP_HEIGHT = 24
CHIP_PAD = 10
HIT_LEAD = 6          # the chip's hit area starts this far left of it, full height
LEARNED_PAD_LEFT = 14
LEARNED_GAP = 8       # check to text
LEARNED_CHIP_GAP = 14
LEARNED_MIN_WIDTH = 200
CHECK_SIZE = 12
SHADOW_MARGIN = 30    # room around the pill for its two shadows
BOTTOM_GAP = 55       # above the bottom of the work area (dock, panel)
BAR_BLOCK = NUM_BARS * BAR_WIDTH + (NUM_BARS - 1) * BAR_GAP  # 116
LABEL_X = PAD_LEFT + BAR_BLOCK + LABEL_GAP


def rgb(r, g, b):
    return (r / 255, g / 255, b / 255)


SURFACE = rgb(26, 26, 26) + (0.93,)
EDGE = (1, 1, 1, 0.08)
INK = rgb(237, 232, 217)          # bars, chip label, learned word
LABEL_INK = rgb(204, 199, 186)    # label, at 0.9 (Cancelled 0.62)
CORAL = rgb(232, 115, 102)        # Failed bars
SUCCESS = rgb(150, 200, 140)
CHIP_FILL = {"rest": 0.12, "hover": 0.22, "pressed": 0.30}

STATE_LABELS = {
    "recording": "Recording",
    "transcribing": "Transcribing",
    "editing": "Editing",
    "done": "Done",
    "silent": "No sound",
    "error": "Failed",
    "cancelled": "Cancelled",
    "learned": "Learned",  # usually overridden with --label "Learned: WORD"
