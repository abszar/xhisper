def sibling(name):
    """The helper next to us (--local checkout) or the installed one."""
    path = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), name)
    return path if os.access(path, os.X_OK) else name


def log(message):
    """Paste steps go to xhisper.log (never the text): a paste that lands
    nowhere is otherwise invisible."""
    try:
        old = os.umask(0o077)
        try:
            with open(LOG_FILE, "a") as f:
                f.write("History: %s\n" % message)
        finally:
            os.umask(old)
    except OSError:
        pass


def run(cmd, timeout=2, data=None):
    """stdout of a short helper, or None."""
    try:
        out = subprocess.run(cmd, input=data, capture_output=True, timeout=timeout)
        return out.stdout.decode("utf-8", "replace").strip() if out.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def active_window():
    """The X11 window that has the focus (id, pid, class), or None. Taken
    before our own window exists: that is where Paste goes."""
    if IS_WAYLAND or not shutil.which("xdotool"):
        return None
    wid = run(["xdotool", "getactivewindow"], timeout=1)
    if not wid or not wid.isdigit():
        return None
    pid = run(["xdotool", "getwindowpid", wid], timeout=1)
    return {"id": wid, "pid": int(pid) if pid and pid.isdigit() else None, "class": window_class(wid)}


def window_class(wid):
    """WM_CLASS as xhisper.sh reads it ("instance,Class"); xdotool before
    2021 has no getwindowclassname, so xprop."""
    klass = run(["xdotool", "getwindowclassname", wid], timeout=1)
    if not klass and shutil.which("xprop"):
        out = run(["xprop", "-id", wid, "WM_CLASS"], timeout=1) or ""
        if "=" in out:
            klass = ",".join(p.strip().strip('"') for p in out.split("=", 1)[1].split(","))
    return klass or ""


