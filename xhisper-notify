#!/usr/bin/env python3
"""xhisper-notify: Animated wave pill overlay for xhisper status."""

import math
import sys
from array import array
import os
import signal
import subprocess
import time

# GTK is optional: without PyGObject we degrade to desktop notifications
# instead of crashing and leaving the user with no feedback at all.
HAS_GTK = True
try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    import cairo
except (ImportError, ValueError):
    HAS_GTK = False

# Detect Wayland and try gtk-layer-shell for overlay positioning
IS_WAYLAND = os.environ.get('XDG_SESSION_TYPE') == 'wayland'
HAS_LAYER_SHELL = False
if IS_WAYLAND and HAS_GTK:
    try:
        gi.require_version('GtkLayerShell', '0.1')
        from gi.repository import GtkLayerShell
        HAS_LAYER_SHELL = True
    except (ValueError, ImportError):
        pass

# Wave bar layout — heights (0–1) matching an audio waveform shape
NUM_BARS = 17
BAR_WIDTH = 5
BAR_GAP = 4
BAR_RADIUS = 2.5
BASE_HEIGHTS = [
    0.30, 0.85, 0.30, 0.90, 0.55, 0.80, 0.95, 0.35,
    0.60, 0.95, 0.80, 0.25, 0.85, 0.90, 0.55, 0.30, 0.50,
]

# Colors
BG_COLOR = (0.10, 0.10, 0.10, 0.93)
BAR_COLOR = (0.93, 0.91, 0.85)
ERROR_BAR_COLOR = (0.91, 0.45, 0.40)
TEXT_COLOR = (0.80, 0.78, 0.73, 0.9)

STATE_LABELS = {
    "recording": "Recording",
    "transcribing": "Transcribing",
    "editing": "Editing",
    "done": "Done",
    "silent": "No sound",
    "error": "Failed",
    "cancelled": "Cancelled",
    "learned": "Learned",  # usually overridden with --label "Learned: WORD"
}

# States whose pill carries a clickable "History" chip. On "recording" a click
# also cancels the dictation (via XHISPER_HISTORYFLAG, polled by xhisper.sh).
HISTORY_STATES = ("recording", "silent")
# States that update the pill already on screen instead of replacing it: one
# pill per dictation (user, 2026-10-14: "too many pop-ups"; a pill that shrank
# into a second look was not liked either). The recording pill keeps its size,
# place and History chip; only its text turns to "Transcribing" and its bars
# settle into the slow wave, through editing as well. done just lets it go, no
# Done pill. silent/error/cancelled/learned still replace it.
IN_PLACE_STATES = ("transcribing", "editing", "done")
# Pills that a later stage of their own dictation may update.
UPDATABLE_STATES = ("recording", "transcribing", "editing")
WORKING_LABEL = STATE_LABELS["transcribing"]
BLEND_SECONDS = 0.35  # live level bars ease into the slow wave
CHIP_LABEL = "History"
CHIP_COLOR = (1.0, 1.0, 1.0, 0.10)
CHIP_HOVER_COLOR = (1.0, 1.0, 1.0, 0.22)
LAUNCH_SECONDS = 0.28  # pill-to-window transition

# Live level meter: while recording, the bars follow the microphone. The pill
# reads the tail of the WAV that pw-record/rec is writing (16-bit mono 16 kHz,
# appended continuously), so no second capture of the mic is needed.
LEVEL_WINDOW_BYTES = 1600     # last 50 ms of audio
LEVEL_PUSH_SECONDS = 0.045    # one new bar value per ~45 ms, scrolling left
LEVEL_MIN_SPAN_DB = 18.0      # quietest dynamic range we stretch to full height

RUNTIME_DIR = os.environ.get("XHISPER_RUNTIME_DIR") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "xhisper")
try:
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
except OSError:
    RUNTIME_DIR = "/tmp"
PID_FILE = os.path.join(RUNTIME_DIR, "xhisper-notify.pid")
NEXT_STATE_FILE = os.path.join(RUNTIME_DIR, "xhisper-notify.next")
HISTORY_FILE = os.environ.get("XHISPER_HISTORY_FILE") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "xhisper", "history.jsonl")


def has_history():
    try:
        return os.path.getsize(HISTORY_FILE) > 0
    except OSError:
        return False


def sibling_command(name):
    """A helper next to us (--local checkout) or the installed one."""
    path = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), name)
    return path if os.access(path, os.X_OK) else name


def history_command():
    return sibling_command("xhisper-history")


# Base class is object when GTK is missing, so the module still imports and
# main() can fall back to notify-send.
class WavePill(Gtk.Window if HAS_GTK else object):
    def __init__(self, state="recording", timeout_ms=0, label=None, unlearn=None):
        wtype = Gtk.WindowType.TOPLEVEL if (IS_WAYLAND and HAS_LAYER_SHELL) else Gtk.WindowType.POPUP
        super().__init__(type=wtype)
        self.state = state
        self.label = label or STATE_LABELS.get(state, state)
        self.start_time = time.time()
        self.fade_alpha = 0.0
        self.slide_progress = 0.0
        self.closing = False
        self.use_layer_shell = IS_WAYLAND and HAS_LAYER_SHELL
        # The chip is "History" on recording/silent pills and "Unlearn" on a
        # learned pill (undo a correction that taught the wrong word).
        self.unlearn = unlearn or []
        if state == "learned" and self.unlearn:
            self.show_chip, self.chip_label = True, "Unlearn"
        else:
            self.show_chip, self.chip_label = state in HISTORY_STATES and has_history(), CHIP_LABEL
        self.show_waves = state != "learned"  # a text-only notice
        self.chip_hover = False
        self.pointer_inside = False
        self.launch_start = None  # set when the History chip is clicked
        self.live = False  # True once the recording file yields audio
        self.blend_start = None  # set when recording turns into transcribing
        if state == "recording":
            self.wav_path = os.environ.get("XHISPER_RECORDING") or os.path.join(RUNTIME_DIR, "xhisper.wav")
            self.levels = [0.0] * NUM_BARS
            self.last_push = 0.0
            self.level = 0.0
            self.noise_floor = None
            self.peak_db = None

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_decorated(False)

        # Dimensions
        # The learned pill is read, not glanced at: bigger text and button.
        self.big = state == "learned"
        self.pill_height = 60 if self.big else 48
        self.font_size = 17 if self.big else 13
        self.chip_font_size = 14 if self.big else 12
        self.max_bar_height = self.pill_height - 14
        self.wave_x = 20
        self.measure()
        self.set_size_request(self.pill_width, self.pill_height + 4)

        if self.use_layer_shell:
            # Wayland: use layer-shell to anchor at bottom-center
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
            GtkLayerShell.set_exclusive_zone(self, -1)
            self.hidden_margin = -(self.pill_height + 10)
            self.visible_margin = 55
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, self.hidden_margin)
        else:
            # X11: position at bottom-center, slide up from below
            display = Gdk.Display.get_default()
            monitor = display.get_primary_monitor() or display.get_monitor(0)
            geom = monitor.get_geometry()
            self.target_x = geom.x + (geom.width - self.pill_width) // 2
            self.screen_bottom = geom.y + geom.height
            self.target_y = self.screen_bottom - self.pill_height - 55
            self.slide_distance = 60
            self.move(self.target_x, self.screen_bottom)

        self.connect('draw', self.on_draw)
        if self.show_chip:
            self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                            | Gdk.EventMask.POINTER_MOTION_MASK
                            | Gdk.EventMask.ENTER_NOTIFY_MASK
                            | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            self.connect('button-press-event', self.on_click)
            self.connect('motion-notify-event', self.on_motion)
            self.connect('enter-notify-event', self.on_enter)
            self.connect('leave-notify-event', self.on_leave)
        GLib.timeout_add(16 if (self.show_chip or state == "recording") else 33, self.on_tick)

        if timeout_ms > 0:
            GLib.timeout_add(max(timeout_ms - 500, 100), self.start_close)

        # Last line of defence: recording/transcribing/editing carry no timeout,
        # so a pill whose registration went missing used to stay on screen until
        # the next reboot. Nothing may outlive the pipeline that spawned it.
        max_life = overlay_max_seconds()
        if max_life > 0:
            GLib.timeout_add_seconds(max_life, lambda: Gtk.main_quit() or False)

        self.show_all()

    def measure(self):
        """Width of the pill for the current label and chip."""
        wave_w = NUM_BARS * BAR_WIDTH + (NUM_BARS - 1) * BAR_GAP
        if self.big:
            # Measure: the 8 px-per-character estimate is too tight at this size.
            probe = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))
            probe.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            probe.set_font_size(self.font_size)
            text_w = int(probe.text_extents(self.label).x_advance) + 24
        else:
            chars = len(self.label)
            if self.state in UPDATABLE_STATES:
                # Room for "Transcribing" from the start: the pill must not
                # change size when its text does.
                chars = max(chars, len(WORKING_LABEL))
            text_w = (chars + 3) * 8 + 8
        if self.show_waves:
            self.text_x = self.wave_x + NUM_BARS * (BAR_WIDTH + BAR_GAP) + 8
            self.pill_width = 24 + wave_w + 16 + text_w + 20
        else:
            self.text_x = 26 if self.big else 24
            self.pill_width = self.text_x + text_w + 12
        if self.show_chip:
            self.chip_w, self.chip_h = (92, 36) if self.big else (72, 28)
            self.chip_x = self.pill_width - 8
            self.chip_y = (self.pill_height - self.chip_h) / 2
            self.pill_width += self.chip_w + 2

    def update_state(self, next_state):
        """A later stage of the same dictation, applied to this pill where it
        stands: no new window, no slide-in. See IN_PLACE_STATES."""
        if self.launch_start is not None or self.closing:
            return
        # A pill of another kind (a Learned notice, a final pill) is not ours to
        # turn into a dictation stage.
        if self.state not in UPDATABLE_STATES:
            return
        if next_state == "done":
            self.start_close()
            return
        if self.state != "recording":
            return
        # Same window, same size, same chip: only the text and the bars change.
        # The live bars are frozen where they stand and eased into the wave.
        t = time.time() - self.start_time
        self.blend_from = [self.bar_height(i, t) for i in range(NUM_BARS)]
        self.blend_start = time.time()
        self.state = "transcribing"
        self.label = WORKING_LABEL

    def start_close(self):
        if self.launch_start is not None:
            return False
        # Never slide away from under the pointer: the user may be reaching
        # for the History chip.
        if self.pointer_inside:
            GLib.timeout_add(400, self.start_close)
            return False
        self.closing = True
        GLib.timeout_add(600, lambda: Gtk.main_quit() or False)
        return False

    def in_chip(self, x, y):
        return (self.chip_x <= x <= self.chip_x + self.chip_w
                and self.chip_y <= y <= self.chip_y + self.chip_h)

    def on_enter(self, _widget, _event):
        self.pointer_inside = True

    def on_leave(self, _widget, _event):
        self.pointer_inside = False
        self.set_chip_hover(False)

    def on_motion(self, _widget, event):
        self.set_chip_hover(self.in_chip(event.x, event.y))

    def set_chip_hover(self, hover):
        if hover == self.chip_hover:
            return
        self.chip_hover = hover
        window = self.get_window()
        if window:
            cursor = Gdk.Cursor.new_from_name(self.get_display(), "pointer") if hover else None
            window.set_cursor(cursor)

    def on_click(self, _widget, event):
        if event.button != 1 or not self.in_chip(event.x, event.y) or self.launch_start is not None:
            return False
        if self.state == "learned":
            return self.do_unlearn()
        if self.state == "recording":
            # Stop listening: xhisper.sh sees the flag, drops the recording,
            # plays the cancel sound and leaves this pill to finish its exit.
            flag = os.environ.get("XHISPER_HISTORYFLAG")
            if flag:
                try:
                    open(flag, "w").close()
                except OSError:
                    pass
        try:
            subprocess.Popen([history_command()], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass
        self.launch_start = time.time()
        GLib.timeout_add(int(LAUNCH_SECONDS * 1000) + 40, lambda: Gtk.main_quit() or False)
        return True

    def do_unlearn(self):
        try:
            subprocess.run([sibling_command("xhisper-learn"), "remove", *self.unlearn],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=5)
            self.label = "Unlearned: " + ", ".join(self.unlearn)
        except (OSError, subprocess.SubprocessError):
            self.label = "Could not unlearn"
        self.show_chip = False
        self.set_chip_hover(False)
        self.pointer_inside = False  # let it close even under the pointer
        GLib.timeout_add(1400, self.start_close)
        return True

    def ease_out_cubic(self, t):
        return 1.0 - (1.0 - t) ** 3

    def read_db(self):
        """RMS of the newest audio in dBFS, or None if nothing is readable yet."""
        try:
            with open(self.wav_path, "rb") as f:
                size = os.fstat(f.fileno()).st_size
                if size < 44 + LEVEL_WINDOW_BYTES:
                    return None
                f.seek(max(44, (size - LEVEL_WINDOW_BYTES) & ~1))
                data = f.read(LEVEL_WINDOW_BYTES)
        except OSError:
            return None
        samples = array("h")
        samples.frombytes(data[:len(data) & ~1])
        if sys.byteorder != "little":
            samples.byteswap()
        if not samples:
            return None
        rms = math.sqrt(sum(x * x for x in samples) / len(samples))
        return 20 * math.log10(max(rms, 1.0) / 32768)

    def sample_level(self):
        """Push one bar value, normalised against the room's noise floor and
        the recent speech peak so any mic gain fills the pill."""
        now = time.time()
        if now - self.last_push < LEVEL_PUSH_SECONDS:
            return
        self.last_push = now
        db = self.read_db()
        if db is None:
            return
        self.live = True
        if self.noise_floor is None:
            self.noise_floor, self.peak_db = db, db + LEVEL_MIN_SPAN_DB
        # Floor follows quiet passages down at once and creeps up slowly;
        # the peak jumps up with speech and decays about 7 dB per second.
        self.noise_floor = min(db, self.noise_floor + 0.05)
        self.peak_db = max(db, self.peak_db - 0.3)
        span = max(self.peak_db - self.noise_floor, LEVEL_MIN_SPAN_DB)
        target = min(1.0, max(0.0, (db - self.noise_floor - 3) / span))
        # Fast attack, softer release, so syllables pop and pauses settle.
        rate = 0.7 if target > self.level else 0.35
        self.level += (target - self.level) * rate
        self.levels = self.levels[1:] + [self.level]

    def on_tick(self):
        if self.state == "recording" and self.launch_start is None:
            self.sample_level()
        if self.launch_start is not None:
            # Transition to the history window: the pill lifts toward where the
            # window opens and fades out while the window fades in.
            p = min(1.0, (time.time() - self.launch_start) / LAUNCH_SECONDS)
            lift = 40 * self.ease_out_cubic(p)
            self.fade_alpha = 1.0 - p
            if self.use_layer_shell:
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, int(self.visible_margin + lift))
            else:
                self.move(self.target_x, int(self.target_y - lift))
            self.queue_draw()
            return True
        if not self.closing:
            self.fade_alpha = min(1.0, self.fade_alpha + 0.12)
            self.slide_progress = min(1.0, self.slide_progress + 0.08)
        else:
            self.fade_alpha = max(0.0, self.fade_alpha - 0.05)
            self.slide_progress = max(0.0, self.slide_progress - 0.06)

        eased = self.ease_out_cubic(self.slide_progress)

        if self.use_layer_shell:
            margin = int(self.hidden_margin + (self.visible_margin - self.hidden_margin) * eased)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, margin)
        else:
            y = self.target_y + self.slide_distance * (1.0 - eased)
            self.move(self.target_x, int(y))

        self.queue_draw()
        return True

    def rounded_rect(self, cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_path()
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.close_path()

    def bar_height(self, i, t):
        if self.state == "recording" and self.live:
            # Newest level enters on the right; the centre is a little taller
            # so the pill keeps its shape.
            weight = 0.75 + 0.25 * math.sin(math.pi * (i + 0.5) / NUM_BARS)
            return max(self.levels[i] * weight * self.max_bar_height, BAR_WIDTH)
        base = BASE_HEIGHTS[i] * self.max_bar_height
        if self.state == "recording":
            f = 0.7 + 0.3 * math.sin(t * 5 + i * 0.45)
        elif self.state in ("transcribing", "editing"):
            f = 0.75 + 0.15 * math.sin(t * 2.5 + i * 0.35)
            if self.blend_start is not None:
                p = (time.time() - self.blend_start) / BLEND_SECONDS
                if p < 1.0:
                    e = self.ease_out_cubic(p)
                    return max(self.blend_from[i] * (1 - e) + base * f * e, BAR_WIDTH)
        elif self.state in ("done", "learned"):
            f = max(0.15, 1.0 - t * 1.5)
        elif self.state in ("silent", "error", "cancelled"):
            f = 0.2 + 0.05 * math.sin(t * 1.5 + i * 0.3)
        else:
            f = 0.5
        return max(base * f, BAR_WIDTH)

    def on_draw(self, widget, cr):
        t = time.time() - self.start_time
        a = self.fade_alpha
        h = self.pill_height
        w = self.pill_width
        r = h / 2
        cy = h / 2

        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        self.rounded_rect(cr, 2, 3, w, h, r)
        cr.set_source_rgba(0, 0, 0, 0.3 * a)
        cr.fill()

        self.rounded_rect(cr, 0, 0, w, h, r)
        cr.set_source_rgba(BG_COLOR[0], BG_COLOR[1], BG_COLOR[2], BG_COLOR[3] * a)
        cr.fill()

        bar_color = ERROR_BAR_COLOR if self.state == "error" else BAR_COLOR
        for i in range(NUM_BARS if self.show_waves else 0):
            bx = self.wave_x + i * (BAR_WIDTH + BAR_GAP)
            bh = self.bar_height(i, t)
            by = cy - bh / 2
            self.rounded_rect(cr, bx, by, BAR_WIDTH, bh, BAR_RADIUS)
            cr.set_source_rgba(bar_color[0], bar_color[1], bar_color[2], a)
            cr.fill()

        dots = ""
        if self.state in ("recording", "transcribing", "editing"):
            dots = "." * (int(t * 2) % 4)
        tx = self.text_x
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(self.font_size)
        ext = cr.text_extents(self.label + dots)
        cr.move_to(tx, cy + ext.height / 2)
        cr.set_source_rgba(TEXT_COLOR[0], TEXT_COLOR[1], TEXT_COLOR[2], TEXT_COLOR[3] * a)
        cr.show_text(self.label + dots)

        if self.show_chip:
            launching = self.launch_start is not None
            color = CHIP_HOVER_COLOR if (self.chip_hover or launching) else CHIP_COLOR
            self.rounded_rect(cr, self.chip_x, self.chip_y, self.chip_w, self.chip_h, self.chip_h / 2)
            cr.set_source_rgba(color[0], color[1], color[2], color[3] * a)
            cr.fill()
            cr.set_font_size(self.chip_font_size)
            ext = cr.text_extents(self.chip_label)
            cr.move_to(self.chip_x + (self.chip_w - ext.width) / 2 - ext.x_bearing,
                       cy + ext.height / 2)
            cr.set_source_rgba(BAR_COLOR[0], BAR_COLOR[1], BAR_COLOR[2], a)
            cr.show_text(self.chip_label)

        return False


def overlay_max_seconds():
    """Hard lifetime cap, in seconds. xhisper.sh passes the value past which it
    considers its own pipeline wedged; 0 disables the cap."""
    try:
        return max(0, int(os.environ.get("XHISPER_OVERLAY_MAX_SECONDS", "900")))
    except ValueError:
        return 900


def read_pid_file():
    try:
        with open(PID_FILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def write_pid_file():
    try:
        with open(PID_FILE, 'w') as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def process_argv(pid):
    try:
        with open('/proc/%d/cmdline' % pid, 'rb') as f:
            return f.read().decode('utf-8', 'replace').split('\0')
    except OSError:
        return []


def hand_over(state):
    """Pass an in-place state to the overlay already on screen. True if it was
    delivered. Only an older overlay qualifies: a slow `done` from the last
    dictation must not close the pill of the next one."""
    pid = read_pid_file()
    me = os.getpid()
    if (pid is None or pid == me or not is_alive(pid)
            or not is_overlay_argv(process_argv(pid))
            or not is_older(pid, start_time(me), me)):
        return False
    try:
        tmp = NEXT_STATE_FILE + ".%d" % me
        with open(tmp, "w") as f:
            f.write(state)
        os.replace(tmp, NEXT_STATE_FILE)
        os.kill(pid, signal.SIGUSR1)
    except OSError:
        return False
    return True


def is_alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def release_pid_file():
    """Drop our registration — but only if it is still ours.

    This used to be an unconditional unlink, which is what left pills stuck on
    screen: an overlay that took longer to shut down than its successor took to
    start would delete the successor's registration, and the next overlay's
    kill_existing() then found nothing to kill.
    """
    if read_pid_file() == os.getpid():
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass


def start_time(pid):
    """Process start time in clock ticks, or None. Field 22 of /proc/pid/stat;
    read past the last ')' because the comm field may contain spaces."""
    try:
        with open('/proc/%d/stat' % pid) as f:
            stat = f.read()
        return int(stat[stat.rindex(')') + 2:].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def is_older(pid, my_start, my_pid):
    """True if pid was started before us. Overlays only ever supersede their
    predecessors — killing a newer one would take down the pill that is meant
    to replace ours."""
    other = start_time(pid)
    if other is None or my_start is None:
        return pid < my_pid
    if other != my_start:
        return other < my_start
    return pid < my_pid


def is_overlay_argv(argv):
    """True if argv is this program running, not something that names it.

    The shebang turns us into `python3 /path/xhisper-notify <state>`, so the
    program is argv[0] (direct exec) or argv[1] behind a python interpreter.
    Matching the basename anywhere in argv also hit `vim xhisper-notify`,
    `less`, `git diff -- xhisper-notify` or a shell script handed the path, and
    killed them on the next dictation.
    """
    if not argv:
        return False
    prog = os.path.basename(argv[0])
    if prog == 'xhisper-notify':
        return True
    return (len(argv) > 1 and prog.startswith('python')
            and os.path.basename(argv[1]) == 'xhisper-notify')


def running_overlays():
    """Every live overlay process older than us, whether or not it is registered.

    The PID file is a single slot and can be lost; scanning /proc cannot. Only
    processes that are actually running this program are targets.
    """
    found = []
    if not os.path.isdir('/proc'):
        return found
    me = os.getpid()
    my_start = start_time(me)
    uid = os.getuid()
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            if os.stat('/proc/%d' % pid).st_uid != uid:
                continue
        except OSError:
            continue
        argv = process_argv(pid)
        if is_overlay_argv(argv):
            if is_older(pid, my_start, me):
                found.append(pid)
    return found


def kill_existing():
    me = os.getpid()
    targets = set(running_overlays())
    recorded = read_pid_file()
    if recorded is not None and recorded != me and is_older(recorded, start_time(me), me):
        targets.add(recorded)

    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    # Wait for them to actually go instead of guessing at a sleep, then insist.
    deadline = time.time() + 0.5
    while targets and time.time() < deadline:
        targets = {pid for pid in targets if is_alive(pid)}
        if targets:
            time.sleep(0.02)
    for pid in targets:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass

    # Clear the slot only when it points at something that is gone, so we never
    # discard a live overlay's registration.
    recorded = read_pid_file()
    if recorded is not None and not is_alive(recorded):
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass


def main():
    if len(sys.argv) < 2:
        print("Usage: xhisper-notify <state> [--timeout MS] [--label TEXT] [--unlearn WORD,...]", file=sys.stderr)
        print("States: recording, transcribing, editing, done, silent, error, cancelled, learned, hide", file=sys.stderr)
        sys.exit(1)

    state = sys.argv[1]
    timeout_ms = 0
    if "--timeout" in sys.argv:
        idx = sys.argv.index("--timeout")
        if idx + 1 < len(sys.argv):
            try:
                timeout_ms = int(sys.argv[idx + 1])
            except ValueError:
                timeout_ms = 0

    label = None
    if "--label" in sys.argv:
        idx = sys.argv.index("--label")
        if idx + 1 < len(sys.argv):
            label = sys.argv[idx + 1]
    unlearn = []
    if "--unlearn" in sys.argv:
        idx = sys.argv.index("--unlearn")
        if idx + 1 < len(sys.argv):
            unlearn = [w for w in sys.argv[idx + 1].split(",") if w]

    # A later stage of a dictation goes to the pill already on screen. It is
    # handed over in a file, then SIGUSR1; the pill installs its handler before
    # it registers its pid, so any pid found there will not die of the signal.
    if state in IN_PLACE_STATES:
        if hand_over(state):
            return
        # Nothing on screen to update: a lone "done" shows nothing.
        if state == "done":
            kill_existing()
            return

    kill_existing()
    if state == "hide":
        return

    # No GTK, or Wayland without layer-shell: fall back to notify-send
    if not HAS_GTK or (IS_WAYLAND and not HAS_LAYER_SHELL):
        label = label or STATE_LABELS.get(state, state)
        t = str(timeout_ms) if timeout_ms > 0 else "30000"
        try:
            subprocess.Popen(['notify-send', '-a', 'xhisper', 'xhisper', label, '-t', t])
        except OSError:
            pass
        return

    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(Gtk.main_quit))

    # Before write_pid_file: from then on a later stage may send SIGUSR1, whose
    # default action would kill us. GLib catches it now and dispatches it once
    # the main loop runs; a state that arrives before the pill exists waits.
    pill = None
    pending = []

    def on_next_state():
        try:
            with open(NEXT_STATE_FILE) as f:
                next_state = f.read().strip()
        except OSError:
            return GLib.SOURCE_CONTINUE
        if pill is None:
            pending[:] = [next_state]
        else:
            pill.update_state(next_state)
        return GLib.SOURCE_CONTINUE

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_next_state)

    # Register before building the window: GTK setup costs about half a second,
    # and until the PID file names us the next overlay cannot find us to kill.
    write_pid_file()

    pill = WavePill(state=state, timeout_ms=timeout_ms, label=label, unlearn=unlearn)
    if pending:
        pill.update_state(pending.pop())
    Gtk.main()

    release_pid_file()


if __name__ == "__main__":
    main()
