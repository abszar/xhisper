def learn_from_edit(old, new):
    """`xhisper-learn diff`, text over stdin; the words it learned."""
    out = run([sibling("xhisper-learn"), "diff"], timeout=10,
              data=json.dumps({"old": old, "new": new}).encode("utf-8"))
    return out.split() if out else []


def unlearn_words(words):
    try:
        return subprocess.run([sibling("xhisper-learn"), "remove", *words], stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def clip_tool():
    return shutil.which("wl-copy" if IS_WAYLAND else "xclip")


def copy_text(text):
    """Copy with a helper that keeps owning the clipboard after we exit; GTK's
    own clipboard would be emptied when this window closes."""
    tools = [["wl-copy"]] if IS_WAYLAND else []
    tools.append(["xclip", "-selection", "clipboard"])
    for cmd in tools:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode("utf-8"), timeout=3,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except (OSError, subprocess.SubprocessError):
                pass
    clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    clipboard.set_text(text, -1)
    clipboard.store()


def read_clipboard():
    """The clipboard's text, or None. Capped: an owner that never answers
    (Chrome, 2026-10-14) must not hold up the paste."""
    cmd = ["wl-paste", "--no-newline"] if IS_WAYLAND else ["xclip", "-o", "-selection", "clipboard"]
    if not shutil.which(cmd[0]):
        return None
    try:
        out = subprocess.run(cmd, capture_output=True, timeout=1)
        return out.stdout.decode("utf-8") if out.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, UnicodeDecodeError):
        return None


TERMINAL_RE = re.compile(r"terminal|konsole|alacritty|kitty|wezterm|foot|xterm|tilix|terminator|yakuake|"
                         r"urxvt|rxvt|ghostty|ptyxis|blackbox|terminology|guake|iterm|warp|hyper|"
                         r"contour|tmux|st,st")


def is_terminal_class(klass):
    """Same rule as xhisper.sh's is_terminal_window: terminals take Ctrl+Shift+V."""
    k = (klass or "").lower()
    return k == "st" or bool(TERMINAL_RE.search(k))


def app_name(klass):
    """"gnome-terminal-server,Gnome-terminal" -> "Gnome Terminal", for the footer."""
    words = [w for w in re.split(r"[-_.\s]+", (klass or "").split(",")[-1]) if w]
    return " ".join(w[:1].upper() + w[1:] for w in words) or "the app"


def pipeline_pid():
    """The live dictation's pid (xhisper.pid "PID EPOCH"), None when none.
    Same test as xhisper.sh's instance_alive, plus a wedge bound."""
    try:
        with open(PIPELINE_PID_FILE) as f:
            parts = f.read().split()
        pid = int(parts[0])
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if b"xhisper" not in f.read():
                return None
        if len(parts) > 1 and time.time() - float(parts[1]) > 1800:
            return None
        return pid
    except (OSError, ValueError, IndexError):
        return None


def paste_keystroke(terminal):
    """Ctrl+V (Ctrl+Shift+V in terminals) through xhispertoold's uinput
    keyboard, started if it is not running. True when it went out."""
    tool = os.environ.get("XHISPERTOOL") or sibling("xhispertool")
    cmd = [tool, "shift-paste" if terminal else "paste"]

    def send():
        try:
            return subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL, timeout=2).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
    if send():
        return True
    log("paste: daemon not answering, starting xhispertoold")
    try:
        with open(os.path.join(RUNTIME_DIR, "xhispertoold.log"), "a") as err:
            subprocess.Popen([sibling("xhispertoold")], stdin=subprocess.DEVNULL, stdout=err, stderr=err,
                             start_new_session=True)
    except OSError:
        return False
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        time.sleep(0.15)
        if send():
            return True
    return False


